{
  "name": "my-jarvis-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "version": "0.1.0",
  "scripts": {
    "build": "cargo build --workspace && pnpm -r build",
    "build:homepage": "pnpm --filter @my-jarvis/homepage run build",
    "build:napi": "node scripts/build-napi.ts",
    "build:desktop": "pnpm --filter @my-jarvis/desktop build:desktop && cargo build -p jarvis-desktop-shell",
    "desktop": "cargo run -p jarvis-desktop-shell",
    "test": "cargo test --workspace && pnpm -r test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  }
}
