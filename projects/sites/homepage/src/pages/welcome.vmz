<template>
  <section class="page">
    <div class="inner narrow">
      <p class="crumb">{{ copy.welcome.crumb }}</p>
      <h1>{{ copy.welcome.title }}</h1>
      <p class="lede">{{ copy.welcome.lede }}</p>

      <ol class="steps">
        <li v-for="(step, index) in copy.welcome.steps" :key="step.title">
          <span class="idx">{{ index + 1 }}</span>
          <div>
            <h2>{{ step.title }}</h2>
            <p>{{ step.body }}</p>
            <a v-if="step.link" class="link" :href="step.href === 'install' ? copy.href.install : copy.href.uses">{{ step.link }}</a>
          </div>
        </li>
      </ol>

      <div class="note">
        <h3>{{ copy.welcome.tipsTitle }}</h3>
        <ul>
          <li v-for="tip in copy.welcome.tips" :key="tip">{{ tip }}</li>
        </ul>
      </div>
    </div>
  </section>
</template>

<style>
.page {
  padding: 104px 0 clamp(56px, 8vh, 84px);
}
.crumb {
  margin: 0 0 12px;
  font-size: 12.5px;
  color: var(--muted);
}
h1 {
  margin: 0 0 16px;
  font-size: clamp(26px, 3vw, 34px);
  line-height: 1.4;
  letter-spacing: -0.015em;
  font-weight: 600;
}
.lede {
  margin: 0 0 36px;
  font-size: 16px;
  line-height: 1.9;
  color: var(--text-2);
}
.steps {
  list-style: none;
  margin: 0 0 40px;
  padding: 0;
  border-top: 1px solid var(--line);
}
.steps li {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr);
  gap: 16px;
  padding: 24px 0;
  border-bottom: 1px solid var(--line);
}
.idx {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}
.steps h2 {
  margin: 0 0 8px;
  font-size: 17px;
  font-weight: 600;
}
.steps p {
  margin: 0 0 10px;
  font-size: 15.5px;
  line-height: 1.9;
  color: var(--muted);
}
.link {
  color: var(--accent);
  font-size: 14px;
  text-decoration: none;
}
.link:hover {
  text-decoration: underline;
}
.note {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 26px;
  background: var(--bg-sub);
}
.note h3 {
  margin: 0 0 14px;
  font-size: 15.5px;
  font-weight: 600;
}
.note ul {
  margin: 0;
  padding-left: 20px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.95;
}
</style>

<script client>
import * as t from "#locales/site";

function readLocale() {
  if (typeof document === "undefined") return "zh-hans";
  let id = "zh-hans";
  try {
    id = localStorage.getItem("mj.locale") || document.documentElement.getAttribute("data-locale") || "zh-hans";
  } catch (error) {
    id = document.documentElement.getAttribute("data-locale") || "zh-hans";
  }
  document.documentElement.setAttribute("data-locale", id);
  document.documentElement.setAttribute("lang", id === "en-us" ? "en" : "zh-CN");
  return id;
}


export default class WelcomePage {
  copy = this.snapshot();

  snapshot() {
    return {
      welcome: {
        crumb: t.welcomeCrumb(),
        title: t.welcomeTitle(),
        lede: t.welcomeLede(),
        tipsTitle: t.welcomeTipsTitle(),
        tips: [t.welcomeTip1(), t.welcomeTip2(), t.welcomeTip3()],
        steps: [
          { title: t.welcome1Title(), body: t.welcome1Body(), link: t.welcome1Link(), href: "install" },
          { title: t.welcome2Title(), body: t.welcome2Body() },
          { title: t.welcome3Title(), body: t.welcome3Body() },
          { title: t.welcome4Title(), body: t.welcome4Body(), link: t.welcome4Link(), href: "uses" },
        ],
      },
      href: { install: "/install", uses: "/d/uses" },
    };
  }

  onMount() {
    if (typeof window === "undefined" || typeof MutationObserver === "undefined") return;
    const el = document.documentElement;
    let last = el.getAttribute("data-locale") || "";
    new MutationObserver(() => {
      const next = el.getAttribute("data-locale") || "";
      if (next === last) return;
      last = next;
      this.copy = this.snapshot();
    }).observe(el, { attributes: true, attributeFilter: ["data-locale"] });
  }
}
</script>
