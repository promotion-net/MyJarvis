}
.trust-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}
.trust-grid li {
  background: #fff;
  padding: 30px 32px;
}
.trust-grid h3 {
  margin: 0 0 10px;
  font-size: 16.5px;
  font-weight: 600;
}
.trust-grid p {
  margin: 0;
  font-size: 15px;
