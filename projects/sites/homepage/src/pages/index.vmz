</style>

<script client>
import * as t from "#locales/site";

function readLocale() {
  if (typeof document === "undefined") return "zh-hans";
  let id = "zh-hans";
  try {
    id = localStorage.getItem("mj.locale") || document.documentElement.getAttribute("data-locale") || "zh-hans";
  } catch (error) {
    id = document.documentElement.getAttribute("data-locale") || "zh-hans";
  }
  document.documentElement.setAttribute("data-locale", id);
  document.documentElement.setAttribute("lang", id === "en-us" ? "en" : "zh-CN");
  return id;
}


export default class IndexPage {
  locale = readLocale();
  copy = this.snapshot();
  exampleIndex = 0;
  timer = 0;

  snapshot() {
    return {
      brand: t.brand(),
      home: {
        title: t.homeTitle(),
        lede: t.homeLede(),
        ctaDownload: t.homeCtaDownload(),
        ctaUses: t.homeCtaUses(),
        foot: t.homeFoot(),
        example: t.homeExample(),
        examples: [t.homeExample1(), t.homeExample2(), t.homeExample3(), t.homeExample4()],
        chatUser: t.homeChatUser(),
        chatAck: t.homeChatAck(),
        chatTask1: t.homeChatTask1(),
        chatTask2: t.homeChatTask2(),
        chatDone: t.homeChatDone(),
        chatDoneState: t.homeChatStateDone(),
        chatProcessing: t.homeChatProcessing(),
        chatInput: t.homeChatInput(),
        sceneTitle: t.homeSceneTitle(),
        sceneNote: t.homeSceneNote(),
        scenes: [
          { idx: "01", title: t.homeScene1Title(), body: t.homeScene1Body() },
          { idx: "02", title: t.homeScene2Title(), body: t.homeScene2Body() },
          { idx: "03", title: t.homeScene3Title(), body: t.homeScene3Body() },
          { idx: "04", title: t.homeScene4Title(), body: t.homeScene4Body() },
        ],
        storyTitle: t.homeStoryTitle(),
        storyNote: t.homeStoryNote(),
        story: [
          { time: t.homeStory1Time(), title: t.homeStory1Title(), body: t.homeStory1Body() },
          { time: t.homeStory2Time(), title: t.homeStory2Title(), body: t.homeStory2Body() },
          { time: t.homeStory3Time(), title: t.homeStory3Title(), body: t.homeStory3Body() },
          { time: t.homeStory4Time(), title: t.homeStory4Title(), body: t.homeStory4Body() },
        ],
        trustTitle: t.homeTrustTitle(),
        trust: [
          { title: t.homeTrust1Title(), body: t.homeTrust1Body() },
          { title: t.homeTrust2Title(), body: t.homeTrust2Body() },
          { title: t.homeTrust3Title(), body: t.homeTrust3Body() },
          { title: t.homeTrust4Title(), body: t.homeTrust4Body() },
        ],
        planTitle: t.homePlanTitle(),
        planLead: t.homePlanLead(),
        planCta: t.homePlanCta(),
        plans: [
          { name: t.homePlan1Name(), body: t.homePlan1Body() },
          { name: t.homePlan2Name(), body: t.homePlan2Body() },
          { name: t.homePlan3Name(), body: t.homePlan3Body() },
        ],
        faqTitle: t.homeFaqTitle(),
        faqs: [
          { q: t.homeFaq1Q(), a: t.homeFaq1A() },
          { q: t.homeFaq2Q(), a: t.homeFaq2A() },
          { q: t.homeFaq3Q(), a: t.homeFaq3A() },
          { q: t.homeFaq4Q(), a: t.homeFaq4A() },
          { q: t.homeFaq5Q(), a: t.homeFaq5A() },
        ],
        finalTitle: t.homeFinalTitle(),
        finalStart: t.homeFinalStart(),
      },
      href: {
        install: "/install",
        uses: "/d/uses",
        membership: "/membership",
        start: "/d/start",
      },
    };
  }

  onMount() {
    if (typeof window === "undefined") return;
    this.timer = setInterval(() => {
      this.exampleIndex = (this.exampleIndex + 1) % this.copy.home.examples.length;
    }, 3800);
    if (typeof MutationObserver !== "undefined") {
      const el = document.documentElement;
      let last = el.getAttribute("data-locale") || "";
      new MutationObserver(() => {
        const next = el.getAttribute("data-locale") || "";
        if (next === last) return;
        last = next;
        this.locale = next;
        this.copy = this.snapshot();
      }).observe(el, { attributes: true, attributeFilter: ["data-locale"] });
    }
  }
}
</script>
