}
.msg-ai {
  align-self: flex-start;
  color: var(--text);
  background: #fff;
  border: 1px solid var(--line);
  animation-delay: 120ms;
}
.msg-last {
  animation-delay: 780ms;
}
.task {
  display: flex;
  align-items: center;
