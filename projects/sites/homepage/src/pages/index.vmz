}
.scene-grid p {
  margin: 0;
  font-size: 15.5px;
  line-height: 1.8;
  color: var(--muted);
}

/* ---------- story ---------- */
.story {
  padding: clamp(64px, 9vh, 104px) 0;
  background: var(--bg-sub);
  border-bottom: 1px solid var(--line);
}
.story-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--line-strong);
}
.story-list li {
  display: grid;
  grid-template-columns: 112px minmax(0, 1fr);
