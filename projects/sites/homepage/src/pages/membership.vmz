  font-size: 15px;
  line-height: 1.95;
}
@media (max-width: 820px) {
  .page {
    padding-top: 92px;
  }
  .tiers {
    grid-template-columns: minmax(0, 1fr);
  }
  .compare {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }
}
</style>

<script client>
import * as t from "#locales/site";

function readLocale() {
  if (typeof document === "undefined") return "zh-hans";
  let id = "zh-hans";
  try {
    id = localStorage.getItem("mj.locale") || document.documentElement.getAttribute("data-locale") || "zh-hans";
  } catch (error) {
    id = document.documentElement.getAttribute("data-locale") || "zh-hans";
  }
  document.documentElement.setAttribute("data-locale", id);
  document.documentElement.setAttribute("lang", id === "en-us" ? "en" : "zh-CN");
  return id;
}


export default class MembershipPage {
  copy = this.snapshot();

  snapshot() {
    return {
      membership: {
        title: t.memberTitle(),
        lede: t.memberLede(),
        feeTitle: t.memberFeeTitle(),
        fees: [t.memberFee1(), t.memberFee2(), t.memberFee3()],
        tiers: [
          {
            name: t.member1Name(),
            line: t.member1Line(),
            price: t.member1Price(),
            cta: t.member1Cta(),
            href: "install",
            items: [t.member1Item1(), t.member1Item2(), t.member1Item3()],
          },
          {
            name: t.member2Name(),
            line: t.member2Line(),
            price: t.member2Price(),
            cta: t.member2Cta(),
            href: "login",
            featured: true,
            items: [t.member2Item1(), t.member2Item2(), t.member2Item3(), t.member2Item4()],
          },
          {
            name: t.member3Name(),
            line: t.member3Line(),
            price: t.member3Price(),
            cta: t.member3Cta(),
            href: "login",
            items: [t.member3Item1(), t.member3Item2(), t.member3Item3(), t.member3Item4()],
          },
        ],
      },
      href: { install: "/install", login: "/login" },
    };
  }

  onMount() {
    if (typeof window === "undefined" || typeof MutationObserver === "undefined") return;
    const el = document.documentElement;
    let last = el.getAttribute("data-locale") || "";
    new MutationObserver(() => {
      const next = el.getAttribute("data-locale") || "";
      if (next === last) return;
      last = next;
      this.copy = this.snapshot();
    }).observe(el, { attributes: true, attributeFilter: ["data-locale"] });
  }
}
</script>
