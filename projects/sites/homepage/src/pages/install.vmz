  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 36px;
  font-size: 13.5px;
  color: var(--text-2);
}
.svc-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--muted-dim);
}
.svc-dot[data-state="online"] {
  background: var(--vmz-status-success-accent);
}
.svc-dot[data-state="offline"] {
  background: var(--vmz-status-danger-accent);
}
.h2 {
  margin: 38px 0 14px;
  font-size: 18px;
  font-weight: 600;
}
.req {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--line);
}
.req li {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  font-size: 14.5px;
  color: var(--text-2);
}
