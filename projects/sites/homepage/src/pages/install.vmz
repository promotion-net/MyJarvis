@media (max-width: 600px) {
  .page {
    padding-top: 92px;
  }
  .faq > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
  }
}
</style>

<script client>
import * as t from "#locales/site";

function readLocale() {
  if (typeof document === "undefined") return "zh-hans";
  let id = "zh-hans";
  try {
    id = localStorage.getItem("mj.locale") || document.documentElement.getAttribute("data-locale") || "zh-hans";
  } catch (error) {
    id = document.documentElement.getAttribute("data-locale") || "zh-hans";
  }
  document.documentElement.setAttribute("data-locale", id);
  document.documentElement.setAttribute("lang", id === "en-us" ? "en" : "zh-CN");
  return id;
}

export default class InstallPage {
  copy = this.snapshot();
  serviceState = "checking";
  serviceText = this.textFor("checking");

  snapshot() {
    return {
      install: {
        crumb: t.installCrumb(),
        title: t.installTitle(),
        lede: t.installLede(),
        win: t.installWin(),
        winMeta: t.installWinMeta(),
        mac: t.installMac(),
        macMeta: t.installMacMeta(),
        soon: t.installSoon(),
        dlNote: t.installDlNote(),
        svcLabel: t.installSvcLabel(),
        svcOnline: t.installSvcOnline(),
        svcOffline: t.installSvcOffline(),
        svcChecking: t.installSvcChecking(),
        reqTitle: t.installReqTitle(),
        reqs: [
          { k: t.installReq1K(), v: t.installReq1V() },
          { k: t.installReq2K(), v: t.installReq2V() },
          { k: t.installReq3K(), v: t.installReq3V() },
          { k: t.installReq4K(), v: t.installReq4V() },
        ],
        afterTitle: t.installAfterTitle(),
        afterBody: t.installAfterBody(),
        helpTitle: t.installHelpTitle(),
        helps: [
          { q: t.installHelp1Q(), a: t.installHelp1A() },
          { q: t.installHelp2Q(), a: t.installHelp2A() },
          { q: t.installHelp3Q(), a: t.installHelp3A() },
        ],
      },
    };
  }

  onMount() {
    if (typeof window === "undefined" || typeof MutationObserver === "undefined") return;
    const el = document.documentElement;
    let last = el.getAttribute("data-locale") || "";
    new MutationObserver(() => {
      const next = el.getAttribute("data-locale") || "";
      if (next === last) return;
      last = next;
      this.copy = this.snapshot();
      this.serviceText = this.textFor(this.serviceState);
    }).observe(el, { attributes: true, attributeFilter: ["data-locale"] });
    this.checkService();
  }

  textFor(state) {
    if (state === "online") return this.copy.install.svcOnline;
    if (state === "offline") return this.copy.install.svcOffline;
    return this.copy.install.svcChecking;
  }

  /** `runtime.json` 的 `apiBase` 为空表示与站点同源，由 CDN 把 `/v0/*` 转到后端。 */
  async readApiBase() {
    try {
      const res = await fetch(`${location.origin}/runtime.json`, { cache: "no-store" });
      if (!res.ok) return "";
      const cfg = await res.json();
      return typeof cfg.apiBase === "string" ? cfg.apiBase.trim() : "";
    } catch (error) {
      return "";
    }
  }

  async checkService() {
    const base = await this.readApiBase();
    this.serviceState = "checking";
    this.serviceText = this.textFor("checking");
    const controller = typeof AbortController !== "undefined" ? new AbortController() : null;
    const timer = setTimeout(() => controller && controller.abort(), 4000);
    try {
      const res = await fetch(`${base.replace(/\/$/, "")}/v0/public/status`, {
        signal: controller ? controller.signal : undefined,
        headers: { accept: "application/json" },
        cache: "no-store",
      });
      this.serviceState = res.ok ? "online" : "offline";
    } catch (error) {
      this.serviceState = "offline";
    }
    clearTimeout(timer);
    this.serviceText = this.textFor(this.serviceState);
  }
}
</script>
