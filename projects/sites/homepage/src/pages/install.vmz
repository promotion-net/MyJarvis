<template>
  <section class="page">
    <div class="inner narrow">
      <p class="crumb">{{ copy.install.crumb }}</p>
      <h1>{{ copy.install.title }}</h1>
      <p class="lede">{{ copy.install.lede }}</p>

      <div class="dl">
        <div class="dl-row">
          <div class="dl-name">
            <span class="dl-title">{{ copy.install.win }}</span>
            <span class="dl-meta">{{ copy.install.winMeta }}</span>
          </div>
          <Tag>{{ copy.install.soon }}</Tag>
        </div>
        <div class="dl-row">
          <div class="dl-name">
            <span class="dl-title">{{ copy.install.mac }}</span>
            <span class="dl-meta">{{ copy.install.macMeta }}</span>
          </div>
          <Tag>{{ copy.install.soon }}</Tag>
        </div>
      </div>
      <p class="dl-note">{{ copy.install.dlNote }}</p>
      <p class="svc" v-if="serviceState !== 'unconfigured'">
        <span class="svc-dot" :data-state="serviceState"></span>
        <span>{{ copy.install.svcLabel }}：{{ serviceText }}</span>
      </p>

      <h2 class="h2">{{ copy.install.reqTitle }}</h2>
      <ul class="req">
        <li v-for="row in copy.install.reqs" :key="row.k"><span>{{ row.k }}</span><span>{{ row.v }}</span></li>
      </ul>

      <h2 class="h2">{{ copy.install.afterTitle }}</h2>
      <p class="p">{{ copy.install.afterBody }}</p>

      <h2 class="h2">{{ copy.install.helpTitle }}</h2>
      <dl class="faq">
        <div v-for="item in copy.install.helps" :key="item.q">
          <dt>{{ item.q }}</dt>
          <dd>{{ item.a }}</dd>
        </div>
      </dl>
    </div>
  </section>
</template>

<style>
.page {
  padding: 104px 0 clamp(56px, 8vh, 84px);
}
.crumb {
  margin: 0 0 12px;
  font-size: 12.5px;
  color: var(--muted);
}
h1 {
  margin: 0 0 14px;
  font-size: clamp(26px, 3vw, 34px);
  line-height: 1.4;
  letter-spacing: -0.015em;
  font-weight: 600;
}
.lede {
  margin: 0 0 32px;
  font-size: 16px;
  line-height: 1.9;
  color: var(--text-2);
}
.dl {
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 12px;
}
.dl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 22px;
  border-bottom: 1px solid var(--line);
}
.dl-row:last-child {
  border-bottom: none;
}
.dl-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
}
.dl-meta {
  display: block;
  margin-top: 4px;
