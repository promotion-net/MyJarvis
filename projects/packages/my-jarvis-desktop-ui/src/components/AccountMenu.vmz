<template>
  <div class="menu">
    <div class="menu__title">Accounts</div>
    <div
      v-for="a in accounts"
      :key="a.id"
      :class="rowClass(a.id)"
      @click="pick(a.id)"
    >
      <span :class="'avatar avatar--' + a.tone">{{ a.initials }}</span>
      <span class="menu__meta">
        <b>{{ a.name }}</b>
        <i>{{ a.plan }} · {{ a.quota }}</i>
      </span>
      <span v-if="isCurrent(a.id)" class="menu__check"><Icon name="action.check" size="sm" /></span>
    </div>
    <div class="menu__line"></div>
    <div class="menu__action" @click="close">
      <span class="avatar avatar--plus">+</span>
      <span class="menu__meta"><b>Add account</b></span>
    </div>
    <div class="menu__action" @click="close">
      <span class="avatar avatar--plus">⇤</span>
      <span class="menu__meta"><b>Sign out</b></span>
    </div>
  </div>
</template>

<style>
.menu {
  position: absolute;
  left: 10px;
  bottom: 58px;
  width: 252px;
  z-index: 30;
  padding: 8px;
  border-radius: 12px;
  border: 1px solid rgba(20, 24, 32, 0.08);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  box-shadow: 0 18px 44px rgba(15, 23, 42, 0.16), 0 2px 6px rgba(15, 23, 42, 0.06);
}
.menu__title {
  padding: 4px 10px 6px;
  font-size: 12px;
  color: var(--text-3);
}
.menu__row,
.menu__action {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 8px;
  border-radius: 8px;
  cursor: pointer;
}
.menu__row:hover,
.menu__action:hover {
  background: var(--hover);
}
.menu__meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.menu__meta b {
  font-size: 13.5px;
  font-weight: 500;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.menu__meta i {
  font-style: normal;
  font-size: 12px;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.menu__check {
  margin-left: auto;
  color: var(--accent);
  width: 16px;
  height: 16px;
}
.menu__line {
  height: 1px;
  margin: 6px 8px;
  background: var(--line);
}
.menu__action .menu__meta b {
  font-weight: 400;
  color: var(--text-2);
}
</style>

<script client>
export default class AccountMenu {
  static __vmzHostBox = "contents";
  public accounts: unknown[] = [];
  public current = "";
  public onPick: ((id: string) => void) | null = null;
  public onClose: (() => void) | null = null;

  isCurrent(id: string): boolean {
    return id === this.current;
  }

  rowClass(id: string): string {
    return id === this.current ? "menu__row menu__row--on" : "menu__row";
  }

  pick(id: string) {
    this.onPick?.(id);
  }

  close() {
    this.onClose?.();
  }
}
</script>
