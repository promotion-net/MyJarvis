</style>

<script client>
interface ChatMessage {
  id: number;
  role: "user" | "assistant";
  text: string;
}

let nextId = 3;

export default class AssistantView {
  public messages: ChatMessage[] = [
    { id: 1, role: "user", text: "Summarize the quarterly report and draft a reply to Zhang Ming." },
    { id: 2, role: "assistant", text: "Summary done, draft ready. Sending needs your approval." },
  ];
  public draft = "";
  public decision = "";

  bubbleClass(role: string): string {
    return "bubble bubble--" + role;
  }

  onDraft(event: Event) {
    const target = event.target as HTMLInputElement | null;
    this.draft = target?.value ?? "";
  }

  send() {
    const text = this.draft.trim();
    if (!text) return;
    this.messages = [
      ...this.messages,
      { id: nextId++, role: "user", text },
      { id: nextId++, role: "assistant", text: "Assistant replies need a connected runtime (D2). This is the D1 mock surface." },
    ];
    this.draft = "";
  }

  approve() {
    this.decision = "Approved";
  }

  decline() {
    this.decision = "Declined";
  }
}
</script>
