  font-size: 14px;
  outline: none;
}
.assistant__send {
  height: 34px;
  padding: 0 16px;
  border: none;
  border-radius: 999px;
  background: #0fdc78;
  color: #004d26;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}
.assistant__ctx {
  flex: none;
  width: 224px;
  padding: 10px;
  display: flex;
  flex-direction: column;
