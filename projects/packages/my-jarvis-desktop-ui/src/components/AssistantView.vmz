  max-width: 72%;
  padding: 8px 12px;
  border-radius: 14px;
  font-size: 14px;
  line-height: 1.45;
}
.bubble--user {
  align-self: flex-end;
  background: #e5fff2;
  border: 1px solid #0fdc78;
  color: #004d26;
}
.bubble--assistant {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.8);
  color: #17171a;
}
.assistant__timeline {
  align-self: flex-start;
  padding: 4px 8px;
  border: 1px dashed rgba(23, 23, 26, 0.25);
  border-radius: 8px;
  font-size: 12px;
  color: #52525b;
}
