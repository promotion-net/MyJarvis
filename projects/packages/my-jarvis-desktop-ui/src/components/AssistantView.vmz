<template>
  <div class="assistant">
    <aside class="assistant__sessions glass">
      <div class="assistant__group">Chief</div>
      <div class="assistant__item assistant__item--on">Quarterly report &amp; reply draft</div>
      <div class="assistant__item">SMS bridge smoke</div>
      <div class="assistant__item">Weekly digest</div>
      <div class="assistant__group">Project A · agent</div>
      <div class="assistant__item">Release notes review</div>
    </aside>
    <section class="assistant__chat glass">
      <div
        v-for="m in messages"
        :key="m.id"
        :class="bubbleClass(m.role)"
      >{{ m.text }}</div>
      <div class="assistant__timeline">
        Chief → mj.llm.complete done → mj.mail.send pending approval
      </div>
      <div class="assistant__composer">
        <input
          class="assistant__input"
          type="text"
          placeholder="Ask the Chief…"
          :value="draft"
          @input="onDraft"
          @keyup.enter="send"
        />
        <button class="assistant__send" type="button" @click="send">Send</button>
      </div>
    </section>
    <aside class="assistant__ctx glass">
      <div class="assistant__ctxtitle">This reply · Chief</div>
      <div class="assistant__model">model <b>fast</b></div>
      <div class="assistant__list">allowlist: <code>fast</code> <code>balanced</code> <code>pin:gpt-x</code> (llm:pin)</div>
      <div class="assistant__approval">
        <div class="assistant__method">mj.mail.send</div>
        <div class="assistant__detail">To: zhangming@example.com · 1 attachment · a meter event will be recorded</div>
        <div class="assistant__btns">
          <button class="assistant__decline" type="button" @click="decline">Decline</button>
          <button class="assistant__approve" type="button" @click="approve">Approve</button>
        </div>
        <p v-if="decision" class="assistant__decision">{{ decision }} (mock — runtime lands in D2)</p>
      </div>
    </aside>
  </div>
</template>

<style>
