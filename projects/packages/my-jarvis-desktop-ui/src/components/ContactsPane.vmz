<template>
  <div class="pane">
    <aside class="index">
      <div class="index__head"><b>Contacts</b></div>
      <div class="index__depts">
        <button type="button" :class="deptClass('')" @click="pickDept('')">All people</button>
        <button v-for="d in depts" :key="d" type="button" :class="deptClass(d)" @click="pickDept(d)">{{ d }}</button>
      </div>
      <div class="index__letters">
        <button
          v-for="l in letters"
          :key="l"
          type="button"
          :class="letterClass(l)"
          @click="pickLetter(l)"
        >{{ l }}</button>
      </div>
      <p class="index__note">People directory sync needs `mj.contact.*` (gap).</p>
    </aside>
    <section class="list">
      <button
        v-for="p in visible"
        :key="p.id"
        type="button"
        :class="rowClass(p.id)"
        data-ctx="default"
        @click="pick(p.id)"
      >
        <span :class="'avatar avatar--md avatar--' + p.tone">{{ p.initials }}</span>
        <span class="list__who">
          <b>{{ p.name }}</b>
          <i>{{ p.title }} · {{ p.dept }}</i>
        </span>
      </button>
      <p v-if="visible.length === 0" class="list__empty">No people match this filter.</p>
    </section>
    <aside v-if="activeContact" class="card">
      <div class="card__top">
        <span :class="'avatar avatar--lg avatar--' + activeContact.tone">{{ activeContact.initials }}</span>
        <div>
          <h3>{{ activeContact.name }}</h3>
          <p>{{ activeContact.title }} · {{ activeContact.dept }}</p>
        </div>
      </div>
      <dl class="card__fields">
        <dt>Email</dt>
        <dd>{{ activeContact.email }}</dd>
        <dt>Phone</dt>
        <dd>{{ activeContact.phone }}</dd>
      </dl>
      <div class="card__actions">
        <button type="button" disabled title="Direct messaging needs a connected channel (mj.im.* gap)">Message</button>
        <button type="button" disabled title="Composing mail needs mj.mail.* (gap)">Email</button>
      </div>
      <p class="card__note">Contact records are local until the directory contract lands.</p>
    </aside>
  </div>
</template>

<style>
