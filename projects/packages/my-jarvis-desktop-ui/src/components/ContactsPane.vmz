</style>

<script client>
import { defaultContacts } from "../lib/shell.js";
import type { ContactItem } from "../lib/shell.js";

export default class ContactsPane {
  static __vmzHostBox = "contents";
  public contacts: ContactItem[] = defaultContacts();
  public active = "p1";
  public dept = "";
  public letter = "";

  get depts(): string[] {
    const seen: string[] = [];
    for (const c of this.contacts) {
      if (!seen.includes(c.dept)) seen.push(c.dept);
    }
    return seen.sort();
  }

  get letters(): string[] {
    const seen: string[] = [];
    for (const c of this.contacts) {
      const l = c.initials.toUpperCase();
      if (!seen.includes(l)) seen.push(l);
    }
    return seen.sort();
  }

  get visible(): ContactItem[] {
    return this.contacts.filter((c) => {
      if (this.dept && c.dept !== this.dept) return false;
      if (this.letter && c.initials.toUpperCase() !== this.letter) return false;
      return true;
    });
  }

  get activeContact(): ContactItem | null {
    return this.contacts.find((c) => c.id === this.active) ?? null;
  }

  deptClass(id: string): string {
    return id === this.dept ? "index__depts--on" : "";
  }

  letterClass(id: string): string {
    return id === this.letter ? "index__letters--on" : "";
  }

  rowClass(id: string): string {
    return id === this.active ? "list__row list__row--on" : "list__row";
  }

  pickDept(id: string) {
    this.dept = id;
  }

  pickLetter(id: string) {
    this.letter = this.letter === id ? "" : id;
  }

  pick(id: string) {
    this.active = id;
  }
}
</script>
