  border: 0;
  background: transparent;
  border-radius: 8px;
  padding: 6px 10px;
  text-align: left;
  font-size: 12.5px;
  color: var(--text-2);
  cursor: pointer;
}
.index__depts button:hover {
  background: var(--hover);
}
.index__depts--on {
  background: var(--accent-soft);
  color: var(--accent-ink);
}
.index__letters {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 0 8px;
}
.index__letters button {
  width: 22px;
  height: 22px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--field);
  color: var(--text-2);
  font-size: 11px;
  cursor: pointer;
}
.index__letters button:hover {
  background: var(--hover);
}
.index__letters--on {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}
.index__note {
  margin: auto 8px 4px;
  font-size: 11px;
  line-height: 1.45;
  color: var(--text-3);
}
.list {
  flex: 1 1 0;
  min-width: 0;
  overflow-y: auto;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: var(--chat);
}
.list__row {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 10px;
  padding: 10px 14px;
  cursor: pointer;
  text-align: left;
}
.list__row:hover {
  background: var(--hover);
}
.list__row--on {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.list__who {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.list__who b {
  font-size: 13.5px;
  color: var(--text-1);
}
.list__who i {
  font-style: normal;
