<template>
  <header class="titlebar" data-tauri-drag-region>
    <span class="titlebar__mark" data-tauri-drag-region>M</span>
    <span class="titlebar__name" data-tauri-drag-region>MyJarvis</span>
    <div class="titlebar__controls">
      <button class="titlebar__btn" type="button" title="Minimize" @click="minimize">
        <Icon name="action.minus" size="sm" />
      </button>
      <button class="titlebar__btn" type="button" title="Maximize" @click="toggleMaximize">
        <Icon :name="maximized ? 'media.fullscreen-exit' : 'media.fullscreen'" size="sm" />
      </button>
      <button class="titlebar__btn titlebar__btn--close" type="button" title="Close" @click="closeWindow">
        <Icon name="action.close" size="sm" />
      </button>
    </div>
  </header>
</template>

<style>
.titlebar {
  flex: none;
  height: 36px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 0 0 12px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  user-select: none;
}
.titlebar__mark {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #23e38a, #0fa968);
  color: #06301a;
  font-size: 11px;
  font-weight: 700;
}
.titlebar__name {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-1);
}
.titlebar__controls {
  margin-left: auto;
  display: flex;
  align-items: stretch;
  height: 100%;
}
.titlebar__btn {
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
}
.titlebar__btn:hover {
  background: var(--hover);
  color: var(--text-1);
}
.titlebar__btn--close:hover {
  background: var(--danger);
  color: #fff;
}
</style>

<script client>
/**
 * Window handle from the Tauri shell. `withGlobalTauri` is enabled, so the page
 * reaches it through `window.__TAURI__` without bundling the Tauri API package.
 */
function shellWindow(): any {
  const tauri: any = (window as any).__TAURI__;
  const get: any = tauri && tauri.window && tauri.window.getCurrentWindow;
  return typeof get === "function" ? get.call(tauri.window) : null;
}

export default class TitleBar {
  static __vmzHostBox = "contents";
  public maximized = false;

  minimize() {
    const win = shellWindow();
    if (win) win.minimize();
  }

  toggleMaximize() {
    const win = shellWindow();
    if (!win) return;
    win.toggleMaximize();
    this.maximized = !this.maximized;
  }

  closeWindow() {
    const win = shellWindow();
    if (win) win.close();
  }
}
</script>
