<template>
  <header class="titlebar">
    <span class="titlebar__mark">M</span>
    <span class="titlebar__name">MyJarvis</span>
    <button
      type="button"
      :class="runtimeClass()"
      :title="runtimeDetail"
      @click="probeRuntime"
    >
      <span class="titlebar__dot"></span>
      <span>{{ runtimeLabel }}</span>
    </button>
    <div class="titlebar__controls">
      <button class="titlebar__btn" type="button" title="Minimize" @click="minimize">
        <Icon name="action.minus" size="sm" />
      </button>
      <button class="titlebar__btn" type="button" title="Maximize" @click="toggleMaximize">
        <Icon :name="maximized ? 'media.fullscreen-exit' : 'media.fullscreen'" size="sm" />
      </button>
      <button class="titlebar__btn titlebar__btn--close" type="button" title="Close" @click="closeWindow">
        <Icon name="action.close" size="sm" />
      </button>
    </div>
  </header>
</template>

<style>
.titlebar {
  flex: none;
  height: 36px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 0 0 12px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  user-select: none;
}
.titlebar__mark {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #23e38a, #0fa968);
  color: #06301a;
  font-size: 11px;
  font-weight: 700;
}
.titlebar__name {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-1);
}
.titlebar__dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--text-3);
}
.titlebar__runtime {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 22px;
  padding: 0 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel);
  color: var(--text-2);
  font-size: 11.5px;
  cursor: pointer;
}
.titlebar__runtime--ok .titlebar__dot {
  background: #12b76a;
}
.titlebar__runtime--off .titlebar__dot {
  background: var(--danger);
}
.titlebar__controls {
  margin-left: auto;
  display: flex;
  align-items: stretch;
  height: 100%;
}
.titlebar__btn {
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
}
.titlebar__btn:hover {
  background: var(--hover);
  color: var(--text-1);
}
.titlebar__btn--close:hover {
  background: var(--danger);
  color: #fff;
}
</style>

<script client>
import { runtimeHealth, windowCommand, windowDragRegions } from "../lib/bridge.js";

export default class TitleBar {
  static __vmzHostBox = "contents";
  public maximized = false;
  public runtimeState = "checking";
  public runtimeLabel = "Runtime…";
  public runtimeDetail = "";
  public pollTimer: any = null;
  public detachResize: (() => void) | null = null;

  onMount() {
    if (typeof window === "undefined") return;
    this.probeRuntime();
    this.pollTimer = window.setInterval(() => this.probeRuntime(), 15000);
    // Frameless window: the host needs the draggable strip minus the control buttons.
    this.reportDragRegions();
    const onResize = () => this.reportDragRegions();
    window.addEventListener("resize", onResize);
    this.detachResize = () => window.removeEventListener("resize", onResize);
  }

  onDestroy() {
    if (this.pollTimer != null) {
      window.clearInterval(this.pollTimer);
      this.pollTimer = null;
    }
    if (this.detachResize) this.detachResize();
    this.detachResize = null;
  }

  reportDragRegions() {
    const bar = document.querySelector(".titlebar");
    if (!bar) return;
    const controls = document.querySelector(".titlebar__controls");
    const box = bar.getBoundingClientRect();
    const reserved = controls ? controls.getBoundingClientRect().width : 132;
    windowDragRegions([{ x: 0, y: 0, width: Math.max(0, box.width - reserved), height: box.height }]).catch(() => undefined);
  }

  runtimeClass(): string {
    return "titlebar__runtime titlebar__runtime--" + this.runtimeState;
  }

  async probeRuntime() {
    const health = await runtimeHealth();
    this.runtimeState = health.ok ? "ok" : "off";
    this.runtimeLabel = health.ok ? "Runtime connected" : "Runtime offline";
    this.runtimeDetail = health.base
      ? "base=" + health.base + " status=" + String(health.status) + " " + health.detail
      : health.detail;
  }

  minimize() {
    windowCommand("minimize").catch(() => undefined);
  }

  toggleMaximize() {
    windowCommand("toggleMaximize")
      .then(() => {
        this.maximized = !this.maximized;
      })
      .catch(() => undefined);
  }

  closeWindow() {
    windowCommand("close").catch(() => undefined);
  }
}
</script>
