  display: flex;
  flex-direction: column;
  gap: 1px;
  border: 0;
  background: transparent;
  border-radius: 8px;
  padding: 8px 10px;
  cursor: pointer;
  text-align: left;
}
.spaces__item:hover {
  background: var(--hover);
}
