<template>
  <div class="pane">
    <aside class="spaces">
      <div class="spaces__head"><b>Spaces</b></div>
      <button
        v-for="s in spaces"
        :key="s.id"
        type="button"
        :class="spaceClass(s.id)"
        @click="pickSpace(s.id)"
      >
        <span>{{ s.name }}</span>
        <i>{{ s.kind }}</i>
      </button>
      <p class="spaces__note">Runtime asset hosting exists; the public `mj.space.*` contract is pending. Listing is local preview.</p>
    </aside>
    <section class="content">
      <header class="content__head">
        <b>{{ activeSpace ? activeSpace.name : "Space" }}</b>
        <span class="content__quota">Quota used {{ activeSpace ? activeSpace.quotaUsed : 0 }}%</span>
      </header>
      <div class="content__bar">
        <button
          v-for="k in kinds"
          :key="k"
          type="button"
          :class="kindClass(k)"
          @click="kind = k"
        >{{ k }}</button>
      </div>
      <div class="content__grid">
        <button
          v-for="o in visibleObjects"
          :key="o.id"
          type="button"
          :class="objectClass(o.id)"
          @click="pickObject(o.id)"
        >
          <Icon :name="iconFor(o.kind)" size="lg" />
          <span>{{ o.name }}</span>
          <i>{{ o.size }}</i>
        </button>
        <p v-if="visibleObjects.length === 0" class="content__empty">No {{ kind }} objects in this space.</p>
      </div>
    </section>
    <aside v-if="activeObject && activeSpace" class="detail">
      <b>{{ activeObject.name }}</b>
      <p class="detail__kind">{{ activeObject.kind }} · {{ activeSpace.name }}</p>
      <p class="detail__line">{{ activeObject.detail }}</p>
      <div class="detail__uri">
        <code>{{ uri }}</code>
        <button type="button" @click="copyUri">{{ copied ? "Copied" : "Copy" }}</button>
      </div>
      <p class="detail__note">References resolve through `jarvis://`; URI carries no permission by itself.</p>
    </aside>
  </div>
</template>

<style>
