  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: var(--chat);
}
.content__head {
  flex: none;
  height: 52px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 20px;
  border-bottom: 1px solid var(--line);
  background: var(--panel);
}
.content__quota {
  margin-left: auto;
  font-size: 12px;
  color: var(--text-3);
}
.content__bar {
  flex: none;
  display: flex;
  gap: 6px;
  padding: 10px 20px 0;
}
.content__bar button {
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 12px;
  color: var(--text-2);
  cursor: pointer;
  text-transform: capitalize;
}
.content__bar button.on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent-ink);
  font-weight: 600;
}
.content__grid {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
  padding: 14px 20px;
  align-content: start;
}
.content__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 12px;
  padding: 16px 10px;
  cursor: pointer;
}
.content__cell:hover {
  border-color: var(--accent);
}
.content__cell--on {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.content__cell span {
  font-size: 12.5px;
  color: var(--text-1);
  text-align: center;
  word-break: break-word;
}
.content__cell i {
  font-style: normal;
  font-size: 11px;
  color: var(--text-3);
}
.content__empty {
  grid-column: 1 / -1;
  color: var(--text-3);
  font-size: 12.5px;
  padding: 20px;
}
