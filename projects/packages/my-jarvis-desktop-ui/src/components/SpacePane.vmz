</style>

<script client>
import { defaultSpaces } from "../lib/shell.js";
import type { SpaceItem, SpaceObject } from "../lib/shell.js";

export default class SpacePane {
  static __vmzHostBox = "contents";
  public spaces: SpaceItem[] = defaultSpaces();
  public activeSpaceId = "7f3ac91d54b84f0a93cd0e21b6a4d5c8";
  public kind = "all";
  public kinds = ["all", "file", "device", "repo", "workspace"];
  public activeObjectId = "o1";
  public copied = false;

  get activeSpace(): SpaceItem | null {
    return this.spaces.find((s) => s.id === this.activeSpaceId) ?? null;
  }

  get visibleObjects(): SpaceObject[] {
    const space = this.activeSpace;
    if (!space) return [];
    return this.kind === "all" ? space.objects : space.objects.filter((o) => o.kind === this.kind);
  }

  get activeObject(): SpaceObject | null {
    return this.visibleObjects.find((o) => o.id === this.activeObjectId) ?? null;
  }

  get uri(): string {
    const space = this.activeSpace;
    const object = this.activeObject;
    if (!space || !object) return "";
    return "jarvis://" + space.id + "/" + object.kind + "/" + object.id;
  }

  spaceClass(id: string): string {
    return id === this.activeSpaceId ? "spaces__item spaces__item--on" : "spaces__item";
  }

  kindClass(k: string): string {
    return k === this.kind ? "on" : "";
  }

  objectClass(id: string): string {
    return id === this.activeObjectId ? "content__cell content__cell--on" : "content__cell";
  }

  iconFor(kind: string): string {
    if (kind === "file") return "file.document";
    if (kind === "device") return "hardware.laptop";
    if (kind === "repo") return "develop.git";
    return "file.folder";
  }

  pickSpace(id: string) {
    this.activeSpaceId = id;
    const space = this.spaces.find((s) => s.id === id);
    const first = space ? space.objects[0] : undefined;
    this.activeObjectId = first ? first.id : "";
    this.copied = false;
  }

  pickObject(id: string) {
    this.activeObjectId = id;
    this.copied = false;
  }

  async copyUri() {
    try {
      await navigator.clipboard.writeText(this.uri);
      this.copied = true;
    } catch {
      this.copied = false;
    }
  }
}
</script>
