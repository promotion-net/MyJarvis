  flex: none;
  width: 300px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 14px;
  background: var(--panel);
  border-left: 1px solid var(--line);
}
.detail__kind {
  margin: 0;
  font-size: 11.5px;
  color: var(--text-3);
  text-transform: capitalize;
}
