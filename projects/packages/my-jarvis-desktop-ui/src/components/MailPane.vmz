<template>
  <div class="pane">
    <aside class="mail__folders">
      <div class="mail__folders_head">
        <b>Mail</b>
        <button class="mail__folders_new" type="button" @click="compose">＋ New</button>
      </div>
      <button
        v-for="f in folders"
        :key="f.id"
        type="button"
        :class="folderClass(f.id)"
        @click="pickFolder(f.id)"
      >
        <span>{{ f.label }}</span>
        <span v-if="f.unread > 0" class="mail__folders_badge">{{ f.unread }}</span>
      </button>
      <p class="mail__folders_note">Mail account connect needs `mj.mail.*` (gap). Inbox shown is local preview.</p>
    </aside>
    <section class="mail__list">
      <header class="mail__list_head">
        <b>{{ folderLabel }}</b>
        <span class="mail__list_count">{{ visible.length }} items</span>
      </header>
      <div class="mail__list_scroll">
        <button
          v-for="m in visible"
          :key="m.id"
          type="button"
          :class="rowClass(m.id)"
          @click="pickMail(m.id)"
        >
          <span :class="'avatar avatar--md avatar--' + m.tone">{{ m.initials }}</span>
          <span class="mail__list_body">
            <span class="mail__list_top"><b>{{ m.sender }}</b><i>{{ m.time }}</i></span>
            <span class="mail__list_subject">{{ m.subject }}</span>
            <span class="mail__list_preview">{{ m.preview }}</span>
          </span>
        </button>
        <p v-if="visible.length === 0" class="mail__list_empty">Nothing here yet.</p>
      </div>
      <article v-if="activeMail" class="mail__read">
        <h3>{{ activeMail.subject }}</h3>
        <p class="mail__read_meta">From {{ activeMail.sender }} · {{ activeMail.time }}</p>
        <p v-for="(line, i) in activeMail.body" :key="i" class="mail__read_line">{{ line }}</p>
        <div class="mail__read_actions">
          <button type="button" @click="reply">Reply</button>
          <button type="button" @click="archive">Archive</button>
        </div>
      </article>
    </section>
    <aside v-if="composing" class="mail__compose">
      <div class="mail__compose_head">
        <b>New mail</b>
        <button type="button" class="mail__compose_x" @click="composing = false">✕</button>
      </div>
      <input class="mail__compose_to" type="text" placeholder="To" :value="to" @input="onTo" />
      <input class="mail__compose_subject" type="text" placeholder="Subject" :value="subject" @input="onSubject" />
      <textarea class="mail__compose_body" placeholder="Message…" :value="body" @input="onBody"></textarea>
      <div class="mail__compose_tools">
        <button type="button" :disabled="drafting" @click="draftWithAssistant">
          {{ drafting ? "Drafting…" : "Draft with assistant" }}
        </button>
        <button type="button" class="mail__compose_send" disabled title="mj.mail.send not available yet">Send</button>
      </div>
      <p v-if="status" class="mail__compose_status">{{ status }}</p>
    </aside>
  </div>
</template>

<style>
