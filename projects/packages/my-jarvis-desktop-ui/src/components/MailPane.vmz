  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: var(--chat);
}
.mail__list_head {
  flex: none;
  height: 52px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 20px;
  border-bottom: 1px solid var(--line);
  background: var(--panel);
}
