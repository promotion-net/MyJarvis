  color: var(--text-3);
}
</style>

<script client>
import { mj } from "@my-jarvis/sdk";
import { defaultMailFolders, defaultMails } from "../lib/shell.js";
import type { MailFolder, MailItem } from "../lib/shell.js";

export default class MailPane {
  static __vmzHostBox = "contents";
  public folders: MailFolder[] = defaultMailFolders();
  public mails: MailItem[] = defaultMails();
  public folder = "inbox";
  public active = "m1";
  public composing = false;
  public drafting = false;
  public to = "";
  public subject = "";
  public body = "";
  public status = "";

  get visible(): MailItem[] {
    return this.mails.filter((m) => m.folder === this.folder);
  }

  get activeMail(): MailItem | null {
    return this.visible.find((m) => m.id === this.active) ?? null;
  }

  get folderLabel(): string {
    return this.folders.find((f) => f.id === this.folder)?.label ?? "Mail";
  }

  folderClass(id: string): string {
    return id === this.folder ? "mail__folders_item mail__folders_item--on" : "mail__folders_item";
  }

  rowClass(id: string): string {
    return id === this.active ? "mail__list_row mail__list_row--on" : "mail__list_row";
  }

  pickFolder(id: string) {
    this.folder = id;
    const first = this.mails.find((m) => m.folder === id);
    this.active = first ? first.id : "";
  }

  pickMail(id: string) {
    this.active = id;
  }

  compose() {
    this.composing = true;
    this.status = "";
  }

  reply() {
    const mail = this.activeMail;
    if (!mail) return;
    this.composing = true;
    this.to = mail.sender;
    this.subject = "Re: " + mail.subject;
    this.body = "";
    this.status = "";
  }

  archive() {
    const mail = this.activeMail;
    if (!mail) return;
    this.mails = this.mails.map((m) => (m.id === mail.id ? { ...m, folder: "archive" } : m));
    this.pickFolder(this.folder);
  }

  onTo(event: Event) {
    this.to = (event.target as HTMLInputElement).value;
  }

  onSubject(event: Event) {
    this.subject = (event.target as HTMLInputElement).value;
  }

  onBody(event: Event) {
    this.body = (event.target as HTMLTextAreaElement).value;
  }

  /** Real round trip: the assistant drafts through `mj.llm.complete` via dispatch. */
  async draftWithAssistant() {
    if (this.drafting) return;
    this.drafting = true;
    this.status = "Drafting through the runtime…";
    try {
      const prompt = "Draft a short professional reply. To: " + this.to + ". Subject: " + this.subject + ". Context: " + this.body;
      const done = await mj.llm.complete({ messages: [{ role: "user", content: prompt }], profile: "fast" });
      this.body = done.text;
      this.status = "Draft ready — sending stays disabled until `mj.mail.send` lands.";
    } catch (err) {
      this.status = "mj.llm.complete failed · " + String(err);
    } finally {
      this.drafting = false;
    }
  }
}
</script>
