  flex: none;
  width: 320px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 14px;
  background: var(--panel);
  border-left: 1px solid var(--line);
}
.mail__compose_head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mail__compose_x {
  border: 0;
  background: transparent;
  color: var(--text-3);
  cursor: pointer;
}
.mail__compose input,
.mail__compose textarea {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--field);
  padding: 8px 10px;
  font: 400 13px/1.5 var(--font);
  color: var(--text-1);
  outline: none;
}
.mail__compose textarea {
  flex: 1;
  min-height: 120px;
  resize: none;
}
.mail__compose input:focus,
.mail__compose textarea:focus {
  border-color: var(--accent);
}
.mail__compose_tools {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}
.mail__compose_tools button {
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 12.5px;
  cursor: pointer;
  color: var(--text-2);
}
.mail__compose_tools button:disabled {
  opacity: 0.55;
  cursor: default;
}
.mail__compose_send {
  background: var(--accent) !important;
  color: #fff;
}
