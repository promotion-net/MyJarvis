<template>
  <nav class="rail">
    <div class="rail__brand" aria-label="MyJarvis">
      <span class="rail__logo">M</span>
    </div>
    <div class="rail__group">
      <button
        v-for="m in modules"
        :key="m.id"
        type="button"
        :class="itemClass(m.id)"
        :title="m.label"
        @click="select(m.id)"
      >
        <Icon :name="m.icon" size="lg" />
        <span v-if="m.dot" class="rail__dot"></span>
      </button>
    </div>
    <div class="rail__spacer"></div>
    <button v-if="showAdmin" type="button" class="rail__item" title="Admin" @click="select('admin')">
      <Icon name="action.sidebar" size="lg" />
    </button>
    <button type="button" class="rail__item" title="Settings" @click="select('settings')">
      <Icon name="action.settings" size="lg" />
    </button>
    <button type="button" class="rail__account" :title="account.name" @click="toggleMenu">
      <span :class="'avatar avatar--' + account.tone">{{ account.initials }}</span>
    </button>
    <AccountMenu
      v-if="menuOpen"
      :accounts="accounts"
      :current="accountId"
      :on-pick="pickAccount"
      :on-close="closeMenu"
    />
  </nav>
</template>

<style>
.rail {
  position: relative;
  flex: none;
  width: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 0 10px;
  gap: 4px;
  border-right: 1px solid var(--line);
  background: var(--rail-bg, rgba(255, 255, 255, 0.72));
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
}
.rail__brand {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}
.rail__logo {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #23e38a, #0fa968);
  color: #06301a;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.rail__group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.rail__item {
  position: relative;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
  transition: background 120ms ease, color 120ms ease;
}
.rail__item:hover {
  background: var(--hover);
  color: var(--text-1);
}
.rail__item--on {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 4px 12px rgba(10, 132, 255, 0.28);
}
.rail__item--on:hover {
  background: var(--accent);
  color: #fff;
}
.rail__item--off {
  color: var(--text-3);
}
.rail__dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--danger);
  border: 1.5px solid #fff;
}
.rail__spacer {
  flex: 1;
}
.rail__account {
  width: 38px;
  height: 38px;
  margin-top: 4px;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: transparent;
  cursor: pointer;
}
.rail__account:hover {
  outline: 2px solid var(--accent-soft);
}
</style>

<script client>
export default class NavRail {
  static __vmzHostBox = "contents";
  public modules: unknown[] = [];
  public accounts: unknown[] = [];
  public active = "assistant";
  public accountId = "";
  public account: { initials?: string; tone?: string; name?: string } = {};
  public showAdmin = false;
  public menuOpen = false;
  public onSelect: ((id: string) => void) | null = null;
  public onPickAccount: ((id: string) => void) | null = null;

  itemClass(id: string): string {
    let cls = "rail__item";
    if (id === this.active) cls += " rail__item--on";
    return cls;
  }

  select(id: string) {
    this.onSelect?.(id);
  }

  toggleMenu() {
    this.menuOpen = !this.menuOpen;
  }

  closeMenu() {
    this.menuOpen = false;
  }

  pickAccount(id: string) {
    this.onPickAccount?.(id);
    this.menuOpen = false;
  }
}
</script>
