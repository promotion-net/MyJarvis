}
.cal__detail_meeting {
  margin-top: 6px;
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 12.5px;
  color: var(--text-2);
  cursor: pointer;
}
.cal__detail_meeting:hover {
  border-color: var(--accent);
  color: var(--accent-ink);
}
