  gap: 2px;
  cursor: pointer;
  text-align: left;
}
.cal__event b {
  font-size: 11px;
  color: var(--text-2);
}
.cal__event span {
  font-size: 12px;
  color: var(--text-1);
}
.event--on {
  outline: 2px solid var(--accent);
}
.cal__week_month {
  flex: 1;
  overflow-y: auto;
  display: grid;
