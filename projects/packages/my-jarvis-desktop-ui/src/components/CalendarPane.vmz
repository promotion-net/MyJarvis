}
.cal__week_cell {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
  min-height: 56px;
  padding: 5px 7px;
  display: flex;
  gap: 3px;
  flex-wrap: wrap;
  align-content: start;
}
