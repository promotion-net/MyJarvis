<template>
  <div class="pane">
    <aside class="cal__side">
      <div class="cal__side_head"><b>Calendar</b></div>
      <label v-for="c in calendars" :key="c.id" class="cal__side_row">
        <input type="checkbox" :checked="c.on" @change="toggleCalendar(c.id)" />
        <span :class="'dot dot--' + c.tone"></span>
        <span>{{ c.label }}</span>
      </label>
      <p class="cal__side_note">Events are local preview until `mj.calendar.*` lands.</p>
    </aside>
    <section class="cal__week">
      <header class="cal__week_head">
        <b>This week</b>
        <div class="cal__week_modes">
          <button type="button" :class="viewClass('day')" @click="view = 'day'">Day</button>
          <button type="button" :class="viewClass('week')" @click="view = 'week'">Week</button>
          <button type="button" :class="viewClass('month')" @click="view = 'month'">Month</button>
        </div>
      </header>
      <div v-if="view === 'week'" class="cal__week_grid">
        <div v-for="(d, i) in days" :key="i" class="cal__week_col">
          <p class="cal__week_dayname">{{ d }}</p>
          <button
            v-for="e in eventsOn(i)"
            :key="e.id"
            type="button"
            :class="eventClass(e)"
            @click="pickEvent(e.id)"
          >
            <b>{{ e.start }}</b>
            <span>{{ e.title }}</span>
          </button>
        </div>
      </div>
      <div v-else-if="view === 'day'" class="cal__week_day">
        <button
          v-for="e in eventsOn(selectedDay)"
          :key="e.id"
          type="button"
          :class="eventClass(e)"
          @click="pickEvent(e.id)"
        >
          <b>{{ e.start }}–{{ e.end }}</b>
          <span>{{ e.title }} · {{ e.where }}</span>
        </button>
        <p v-if="eventsOn(selectedDay).length === 0" class="cal__week_empty">Free day.</p>
      </div>
      <div v-else class="cal__week_month">
        <div v-for="i in 30" :key="i" class="cal__week_cell">
          <i>{{ i }}</i>
          <span v-for="e in monthEvents(i)" :key="e.id" class="cal__week_chip">•</span>
        </div>
      </div>
    </section>
    <aside v-if="activeEvent" class="cal__detail">
      <b>{{ activeEvent.title }}</b>
      <p class="cal__detail_time">{{ days[activeEvent.day] }} · {{ activeEvent.start }}–{{ activeEvent.end }}</p>
      <p class="cal__detail_line">Where: {{ activeEvent.where }}</p>
      <p class="cal__detail_line">Attendees: {{ activeEvent.attendees }}</p>
      <button type="button" class="cal__detail_meeting" @click="openMeeting">Open meeting details</button>
      <p class="cal__detail_note">Event CRUD and reminders need the calendar contract; assistant scheduling will draft events for confirmation.</p>
    </aside>
  </div>
</template>

<style>
