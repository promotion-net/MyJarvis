</style>

<script client>
import { defaultCalendarEvents } from "../lib/shell.js";
import type { CalendarEvent } from "../lib/shell.js";

export default class CalendarPane {
  static __vmzHostBox = "contents";
  public days = ["Mon", "Tue", "Wed", "Thu", "Fri"];
  public events: CalendarEvent[] = defaultCalendarEvents();
  public view = "week";
  public selectedDay = 2;
  public active = "e2";
  public calendars = [
    { id: "work", label: "Work", tone: "blue", on: true },
    { id: "personal", label: "Personal", tone: "green", on: true },
    { id: "birthdays", label: "Birthdays", tone: "violet", on: false },
  ];
  public onOpenMeeting: (() => void) | null = null;

  get activeEvent(): CalendarEvent | null {
    return this.events.find((e) => e.id === this.active) ?? null;
  }

  viewClass(v: string): string {
    return this.view === v ? "on" : "";
  }

  eventsOn(day: number): CalendarEvent[] {
    return this.events.filter((e) => e.day === day);
  }

  monthEvents(dayOfMonth: number): CalendarEvent[] {
    return this.events.filter((e) => e.day + 1 === dayOfMonth % 5);
  }

  eventClass(e: CalendarEvent): string {
    return e.id === this.active ? "event event--on" : "event";
  }

  pickEvent(id: string) {
    this.active = id;
  }

  toggleCalendar(id: string) {
    this.calendars = this.calendars.map((c) => (c.id === id ? { ...c, on: !c.on } : c));
  }

  openMeeting() {
    this.onOpenMeeting?.();
  }
}
</script>
