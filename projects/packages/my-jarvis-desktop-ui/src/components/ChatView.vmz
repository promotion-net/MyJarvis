<template>
  <section class="chat">
    <header class="chat__head">
      <span class="avatar avatar--md avatar--green">C</span>
      <span class="chat__id">
        <b>Chief</b>
        <i>Personal agent · fast · allowlist 3 models</i>
      </span>
      <button class="chat__tool" type="button" title="Details" @click="toggleDetail">
        <Icon name="action.sidebar" size="md" />
      </button>
    </header>
    <div class="chat__scroll">
      <div
        v-for="m in messages"
        :key="m.id"
        data-ctx="message"
        :class="messageClass(m.role)"
      >
        <template v-if="m.role === 'system'">
          <span class="chat__system">{{ m.text }}</span>
        </template>
        <template v-else>
          <div :class="bubbleClass(m.role)">{{ m.text }}</div>
          <span class="chat__time">{{ m.time }}</span>
        </template>
      </div>
    </div>
    <div class="chat__composer">
      <input
        class="chat__input"
        type="text"
        placeholder="Message the Chief…"
        :value="draft"
        @input="onDraft"
      />
      <button class="chat__send" type="button" title="Send" :disabled="sending" @click="send">
        <Icon name="action.send" size="md" />
      </button>
    </div>
  </section>
</template>

<style>
.chat {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: var(--chat);
}
.chat__head {
  flex: none;
  height: 56px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 20px;
  border-bottom: 1px solid var(--line);
  background: var(--panel);
}
.chat__id {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}
.chat__id b {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-1);
}
.chat__id i {
  font-style: normal;
  font-size: 11.5px;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chat__tool {
  margin-left: auto;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
}
.chat__tool:hover {
  background: var(--hover);
  color: var(--text-1);
}
.chat__scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 20px 22px 8px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.chat__row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.chat__row--user {
  align-items: flex-end;
}
.chat__row--agent {
  align-items: flex-start;
}
.chat__row--system {
  align-items: center;
  padding: 2px 0;
}
.bubble {
  max-width: 62%;
  padding: 9px 13px;
  border-radius: 14px;
  font-size: 13.5px;
  line-height: 1.5;
  word-break: break-word;
}
.bubble--user {
  background: var(--accent);
  color: #fff;
  border-bottom-right-radius: 5px;
  box-shadow: 0 2px 6px rgba(10, 132, 255, 0.18);
}
.bubble--agent {
  background: var(--panel);
  color: var(--text-1);
  border: 1px solid var(--line);
  border-bottom-left-radius: 5px;
}
.chat__time {
  font-size: 10.5px;
  color: var(--text-3);
  padding: 0 4px;
}
.chat__system {
  max-width: 70%;
  text-align: center;
  font-size: 11px;
  color: var(--text-3);
  background: var(--soft);
  padding: 4px 12px;
  border-radius: 999px;
}
.chat__composer {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px 16px;
  background: var(--chat);
}
.chat__input {
  flex: 1;
  min-width: 0;
  height: 38px;
  padding: 0 14px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--text-1);
  font: 400 13.5px/1 var(--font);
  outline: none;
}
.chat__input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
.chat__input::placeholder {
  color: var(--text-3);
}
.chat__send {
  flex: none;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 10px;
  background: var(--accent);
  color: #fff;
  cursor: pointer;
}
.chat__send:hover {
  background: var(--accent-hover);
}
.chat__send:disabled {
  opacity: 0.55;
  cursor: default;
}
</style>

<script client>
import { mj } from "@my-jarvis/sdk";
import type { LlmMessage, LlmProfile } from "@my-jarvis/types";

interface ChatMessage {
  id: number;
  role: string;
  text: string;
  time: string;
}

let nextId = 100;

export default class ChatView {
  static __vmzHostBox = "contents";
  public messages: ChatMessage[] = [];
  public draft = "";
  public sending = false;
  public model = "fast";
  public onToggleDetail: (() => void) | null = null;

  messageClass(role: string): string {
    return "chat__row chat__row--" + role;
  }

  bubbleClass(role: string): string {
    return role === "user" ? "bubble bubble--user" : "bubble bubble--agent";
  }

  onDraft(event: Event) {
    const target = event.target as HTMLInputElement | null;
    this.draft = target ? target.value : "";
  }

  /** Conversation history the runtime sees: only user/assistant turns, never UI system lines. */
  history(): LlmMessage[] {
    const turns: LlmMessage[] = [];
    for (const m of this.messages) {
      if (m.role === "user") turns.push({ role: "user", content: m.text });
      else if (m.role === "agent") turns.push({ role: "assistant", content: m.text });
    }
    return turns;
  }

  async send() {
    const text = this.draft.trim();
    if (!text || this.sending) return;
    this.draft = "";
    this.messages = [...this.messages, { id: nextId++, role: "user", text, time: "now" }];
    const turns = this.history();
    this.sending = true;
    try {
      const reply = await mj.agent.turn({ messages: turns, profile: this.model as LlmProfile });
      this.messages = [
        ...this.messages,
        { id: nextId++, role: "agent", text: reply.message.content, time: "now" },
      ];
    } catch (err) {
      this.messages = [
        ...this.messages,
        { id: nextId++, role: "system", text: "mj.agent.turn failed · " + String(err), time: "now" },
      ];
    } finally {
      this.sending = false;
    }
  }

  toggleDetail() {
    this.onToggleDetail?.();
  }
}
</script>
