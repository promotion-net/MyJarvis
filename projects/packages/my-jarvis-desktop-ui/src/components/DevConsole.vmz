</style>

<script client>
import { invokeDispatch } from "../lib/bridge.js";
import { CAPABILITIES } from "@my-jarvis/types";

interface CallRow {
  id: number;
  method: string;
  ok: boolean;
  ms: number;
}

const TEMPLATES: Record<string, string> = {
  "backend:provision": '{\n  "name": "demo"\n}',
  "db:migrate": '{\n  "sql": "CREATE TABLE IF NOT EXISTS t (id INTEGER PRIMARY KEY)"\n}',
  "db:query": '{\n  "sql": "SELECT 1 AS ok"\n}',
  "server:route": '{\n  "path": "/demo"\n}',
  "llm:complete": '{\n  "messages": [{ "role": "user", "content": "ping" }],\n  "profile": "fast"\n}',
  "sms:send": '{\n  "to": "+8613800000000",\n  "text": "hello"\n}',
};

let nextLogId = 1;

export default class DevConsole {
  static __vmzHostBox = "contents";
  public capabilities: any[] = CAPABILITIES;
  public activeId = "backend:provision";
  public paramsText = TEMPLATES["backend:provision"] || "{}";
  public resultText = "";
  public statusText = "idle";
  public statusKind = "idle";
  public running = false;
  public log: CallRow[] = [];
  public onStatus: ((ok: boolean, detail: string) => void) | null = null;

  entryClass(id: string): string {
    return id === this.activeId ? "dev__row dev__row--on" : "dev__row";
  }

  statusClass(): string {
    return "dev__status" + (this.statusKind === "idle" ? "" : " dev__status--" + this.statusKind);
  }

  methodName(): string {
    return "mj." + this.activeId.replace(":", ".");
  }

  pick(id: string) {
    this.activeId = id;
    this.paramsText = TEMPLATES[id] || "{}";
    this.resultText = "";
    this.statusText = "idle";
    this.statusKind = "idle";
  }

  onParams(event: Event) {
    const target = event.target as HTMLTextAreaElement | null;
    this.paramsText = target ? target.value : "";
  }

  async invoke() {
    if (this.running) return;
    let params: Record<string, unknown>;
    try {
      params = JSON.parse(this.paramsText || "{}");
    } catch (err) {
      this.resultText = "";
      this.statusText = "invalid JSON: " + String(err);
      this.statusKind = "err";
      return;
    }
    const method = this.methodName();
    this.running = true;
    this.statusText = "running…";
    this.statusKind = "idle";
    const started = Date.now();
    try {
      const result = await invokeDispatch(method, params);
      this.resultText = JSON.stringify(result, null, 2);
      this.statusText = "ok";
      this.statusKind = "ok";
      this.pushLog(method, true, Date.now() - started);
      this.report(true, this.resultText);
    } catch (err) {
      this.resultText = String(err);
      this.statusText = "error";
      this.statusKind = "err";
      this.pushLog(method, false, Date.now() - started);
      this.report(false, String(err));
    } finally {
      this.running = false;
    }
  }

  pushLog(method: string, ok: boolean, ms: number) {
    this.log = [{ id: nextLogId++, method, ok, ms }, ...this.log].slice(0, 20);
  }

  report(ok: boolean, detail: string) {
    this.onStatus?.(ok, detail);
  }
}
</script>
