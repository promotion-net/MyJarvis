<template>
  <div class="dev">
    <aside class="dev__list">
      <div class="dev__head">
        <span class="dev__title">Capabilities</span>
        <span class="dev__count">{{ capabilities.length }}</span>
      </div>
      <div class="dev__scroll">
        <div
          v-for="c in capabilities"
          :key="c.id"
          :class="entryClass(c.id)"
          @click="pick(c.id)"
        >
          <span class="dev__meta">
            <b>{{ c.id }}</b>
            <i>{{ c.summary }}</i>
          </span>
        </div>
      </div>
    </aside>

    <section class="dev__main">
      <header class="dev__main-head">
        <b>{{ methodName() }}</b>
        <span class="dev__hint">POST /v0/dispatch · appId is this install</span>
      </header>
      <div class="dev__body">
        <label class="dev__field">
          <span class="dev__label">params (JSON)</span>
          <textarea class="dev__params" :value="paramsText" @input="onParams"></textarea>
        </label>
        <div class="dev__actions">
          <button class="dev__run" type="button" :disabled="running" @click="invoke">
            {{ running ? "Running…" : "Invoke" }}
          </button>
          <span :class="statusClass()">{{ statusText }}</span>
        </div>
        <div class="dev__field">
          <span class="dev__label">result</span>
          <pre class="dev__result">{{ resultText }}</pre>
        </div>
      </div>
    </section>

    <aside class="dev__side">
      <div class="dev__side-head"><b>Call log</b></div>
      <div class="dev__side-body">
        <div class="dev__log" v-for="row in log" :key="row.id">
          <b>{{ row.method }}</b>
          <i :class="row.ok ? 'dev__ok' : 'dev__err'">{{ row.ok ? "ok" : "error" }} · {{ row.ms }}ms</i>
        </div>
        <p class="dev__empty" v-if="log.length === 0">No calls yet.</p>
      </div>
    </aside>
  </div>
</template>

<style>
