</style>

<script client>
import { defaultAgents, defaultModelCatalog } from "../lib/shell.js";
import type { AgentDef } from "../lib/shell.js";

export default class AgentSettings {
  static __vmzHostBox = "contents";
  public agents: AgentDef[] = defaultAgents();
  public activeId = "agent-chief";
  public draftName = "Chief";
  public pendingModel = "";
  public onOpenMessages: (() => void) | null = null;

  active(): AgentDef {
    const found = this.agents.find((a: AgentDef) => a.id === this.activeId);
    return found || this.agents[0];
  }

  rowClass(id: string): string {
    return id === this.activeId ? "agents__row agents__row--on" : "agents__row";
  }

  catalog(): string[] {
    const used = this.active().models;
    return defaultModelCatalog().filter((m: string) => !used.includes(m));
  }

  spaceUri(): string {
    return "jarvis://" + this.active().spaceId;
  }

  pick(id: string) {
    this.activeId = id;
    this.draftName = this.active().name;
  }

  onRename(event: Event) {
    const target = event.target as HTMLInputElement | null;
    this.draftName = target ? target.value : "";
    const agent = this.active();
    agent.name = this.draftName;
  }

  onPickModel(event: Event) {
    const target = event.target as HTMLSelectElement | null;
    this.pendingModel = target ? target.value : "";
  }

  addModel() {
    const model = this.pendingModel;
    if (!model) return;
    const agent = this.active();
    if (agent.models.includes(model)) return;
    agent.models = [...agent.models, model];
    this.pendingModel = "";
  }

  removeModel(model: string) {
    const agent = this.active();
    if (agent.isChief && agent.models.length === 1) return;
    agent.models = agent.models.filter((m: string) => m !== model);
  }

  newAgent() {
    const id = "agent-" + String(this.agents.length + 1);
    this.agents = [
      ...this.agents,
      {
        id,
        name: "New agent",
        initials: "N",
        tone: "slate",
        isChief: false,
        models: ["balanced"],
        capabilities: ["jarvis:llm.complete"],
        space: this.active().space,
        spaceId: this.active().spaceId,
        lastUsed: "never",
        calls24h: 0,
        pendingApprovals: 0,
      },
    ];
    this.pick(id);
  }

  openConversation() {
    this.onOpenMessages?.();
  }
}
</script>
