<template>
  <div class="agents">
    <aside class="agents__list">
      <div class="agents__head">
        <span class="agents__title">Agents</span>
        <button class="agents__add" type="button" title="New agent" @click="newAgent">
          <Icon name="action.plus" size="sm" />
        </button>
      </div>
      <div class="agents__scroll">
        <div
          v-for="a in agents"
          :key="a.id"
          data-ctx="agent"
          :class="rowClass(a.id)"
          @click="pick(a.id)"
        >
          <span :class="'avatar avatar--md avatar--' + a.tone">{{ a.initials }}</span>
          <span class="agents__meta">
            <span class="agents__name">
              <b>{{ a.name }}</b>
              <i v-if="a.isChief" class="agents__chief">Chief</i>
            </span>
            <i class="agents__sub">{{ a.models.length }} models · {{ a.lastUsed }}</i>
          </span>
        </div>
      </div>
    </aside>

    <section class="agents__form">
      <header class="agents__form-head">
        <span :class="'avatar avatar--lg avatar--' + active().tone">{{ active().initials }}</span>
        <span class="agents__form-id">
          <b>{{ active().name }}</b>
          <i>Configuration only · conversations live in Messages</i>
        </span>
        <button class="agents__open" type="button" @click="openConversation">Open conversation</button>
      </header>

      <div class="agents__body">
        <label class="agents__field">
          <span class="agents__label">Name</span>
          <input class="agents__input" type="text" :value="draftName" @input="onRename" />
        </label>

        <section class="agents__block">
          <div class="agents__label">Model allowlist</div>
          <div class="agents__chips">
            <span v-for="m in active().models" :key="m" class="chip chip--model">
              {{ m }}
              <button class="chip__x" type="button" title="Remove" @click="removeModel(m)">×</button>
            </span>
          </div>
          <div class="agents__add-row">
            <select class="agents__select" :value="pendingModel" @change="onPickModel">
              <option value="">Add a model…</option>
              <option v-for="m in catalog()" :key="m" :value="m">{{ m }}</option>
            </select>
            <button class="agents__confirm" type="button" @click="addModel">Add</button>
          </div>
          <p class="agents__hint">
            Requests outside this list are rejected. Adding a model is explicit and leaves an audit entry.
          </p>
        </section>

        <section class="agents__block">
          <div class="agents__label">Capabilities</div>
          <div class="agents__chips">
            <span v-for="c in active().capabilities" :key="c" class="chip mono">{{ c }}</span>
          </div>
        </section>

        <section class="agents__block">
          <div class="agents__label">Space</div>
          <div class="agents__space">
            <b>{{ active().space }}</b>
            <code>{{ spaceUri() }}</code>
          </div>
        </section>
      </div>
    </section>

    <aside class="agents__side">
      <div class="agents__side-head"><b>Audit</b></div>
      <div class="agents__side-body">
        <div class="agents__stat"><span>Model calls (24h)</span><b>{{ active().calls24h }}</b></div>
        <div class="agents__stat"><span>Pending approvals</span><b>{{ active().pendingApprovals }}</b></div>
        <div class="agents__stat"><span>Last used</span><b>{{ active().lastUsed }}</b></div>
        <p class="agents__hint">
          This page never runs a conversation. Chat with an agent from Messages so the transcript, approvals and
          metering stay on one surface.
        </p>
      </div>
    </aside>
  </div>
</template>

