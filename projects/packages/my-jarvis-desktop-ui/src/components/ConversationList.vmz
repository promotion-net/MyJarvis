<template>
  <aside class="list">
    <div class="list__head">
      <label class="list__search">
        <Icon name="action.search" size="sm" />
        <input class="list__input" type="text" placeholder="Search" readonly />
      </label>
      <button class="list__add" type="button" title="New conversation">
        <Icon name="action.plus" size="md" />
      </button>
    </div>
    <div class="list__scroll">
      <div
        v-for="c in conversations"
        :key="c.id"
        data-ctx="conversation"
        :class="rowClass(c.id)"
        @click="choose(c.id)"
      >
        <span :class="'avatar avatar--lg avatar--' + c.tone">{{ c.initials }}</span>
        <span class="list__body">
          <span class="list__top">
            <b class="list__title">{{ c.title }}</b>
            <i class="list__time">{{ c.time }}</i>
          </span>
          <span class="list__bottom">
            <i class="list__preview">{{ c.preview }}</i>
            <span v-if="hasUnread(c.unread)" class="list__badge">{{ c.unread }}</span>
          </span>
        </span>
      </div>
    </div>
  </aside>
</template>

<style>
.list {
  flex: none;
  width: 276px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--line);
  background: var(--panel);
}
.list__head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 14px 10px;
}
.list__search {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6px;
  height: 30px;
  padding: 0 10px;
  border-radius: 8px;
  background: var(--field);
  color: var(--text-3);
}
.list__input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--text-1);
  font: 400 12.5px/1 var(--font);
}
.list__input::placeholder {
  color: var(--text-3);
}
.list__add {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 8px;
  background: var(--field);
  color: var(--text-2);
  cursor: pointer;
}
.list__add:hover {
  background: var(--hover);
  color: var(--text-1);
}
.list__scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 2px 8px 10px;
}
.list__row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 8px;
  border-radius: 10px;
  cursor: pointer;
}
.list__row:hover {
  background: var(--hover);
}
.list__row--on {
  background: var(--accent-soft);
}
.list__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.list__top,
.list__bottom {
  display: flex;
  align-items: center;
  gap: 8px;
}
.list__title {
  flex: 1;
  min-width: 0;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.list__time {
  flex: none;
  font-style: normal;
  font-size: 11px;
  color: var(--text-3);
}
.list__preview {
  flex: 1;
  min-width: 0;
  font-style: normal;
  font-size: 12px;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.list__badge {
  flex: none;
  min-width: 17px;
  height: 17px;
  padding: 0 5px;
  border-radius: 999px;
  background: var(--danger);
  color: #fff;
  font-size: 10.5px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.list__row--on .list__title {
  color: var(--accent-ink);
}
</style>

<script client>
export default class ConversationList {
  static __vmzHostBox = "contents";
  public conversations: unknown[] = [];
  public activeId = "";
  public onSelect: ((id: string) => void) | null = null;

  rowClass(id: string): string {
    return id === this.activeId ? "list__row list__row--on" : "list__row";
  }

  hasUnread(count: number): boolean {
    return count > 0;
  }

  choose(id: string) {
    this.onSelect?.(id);
  }
}
</script>
