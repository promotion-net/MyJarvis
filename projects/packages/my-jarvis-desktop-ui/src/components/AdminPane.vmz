  flex: 1 1 0;
  min-width: 0;
  overflow-y: auto;
  padding: 18px 22px;
  background: var(--chat);
}
.body__head {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.body__head h3 {
  margin: 0;
  font-size: 16px;
}
