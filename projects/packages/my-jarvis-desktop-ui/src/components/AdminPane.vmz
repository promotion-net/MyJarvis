  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px dashed var(--line);
  background: transparent;
  border-radius: 8px;
  padding: 8px 10px;
  text-align: left;
  font-size: 12px;
  color: var(--text-2);
  cursor: pointer;
}
