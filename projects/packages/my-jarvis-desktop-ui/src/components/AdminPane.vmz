  font-size: 13px;
}
.rows__who i {
  font-style: normal;
  font-size: 11.5px;
  color: var(--text-3);
}
.rows__item button {
  border: 1px solid var(--line);
  background: var(--soft);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 12px;
  color: var(--text-3);
  cursor: default;
}
.rows__empty {
  font-size: 12.5px;
  color: var(--text-3);
}
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 60px 20px;
  color: var(--text-3);
