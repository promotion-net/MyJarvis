</style>

<script client>
import { defaultAdminDevices, defaultAdminSections, defaultAccounts, defaultAgents, defaultContacts } from "../lib/shell.js";
import type { AdminSection, ContactItem } from "../lib/shell.js";

interface DeviceRow {
  id: string;
  name: string;
  lastActive: string;
  points: string;
  today: string;
  flagged: boolean;
}

export default class AdminPane {
  static __vmzHostBox = "contents";
  public sections: AdminSection[] = defaultAdminSections();
  public devices: DeviceRow[] = defaultAdminDevices();
  public accounts = defaultAccounts();
  public agents = defaultAgents();
  public contacts: ContactItem[] = defaultContacts();
  public section = "org";
  public selected: string[] = [];
  public onOpenDev: (() => void) | null = null;

  get activeSection(): AdminSection | null {
    return this.sections.find((s) => s.id === this.section) ?? null;
  }

  get selectedNames(): string {
    return this.devices
      .filter((d) => this.selected.includes(d.id))
      .map((d) => d.name)
      .join(", ");
  }

  get approvalAgents() {
    return this.agents.filter((a) => a.pendingApprovals > 0);
  }

  get depts(): string[] {
    const seen: string[] = [];
    for (const c of this.contacts) {
      if (!seen.includes(c.dept)) seen.push(c.dept);
    }
    return seen.sort();
  }

  countDept(dept: string): number {
    return this.contacts.filter((c) => c.dept === dept).length;
  }

  rowClass(id: string): string {
    return id === this.section ? "tree__row tree__row--on" : "tree__row";
  }

  pick(id: string) {
    this.section = id;
  }

  toggleDevice(id: string) {
    if (this.selected.includes(id)) {
      this.selected = this.selected.filter((x) => x !== id);
    } else {
      this.selected = [...this.selected, id];
    }
  }

  openDev() {
    this.onOpenDev?.();
  }
}
</script>
