  display: grid;
  grid-template-columns: 26px 1.4fr 1fr 1fr 0.8fr;
  gap: 10px;
  align-items: center;
  padding: 10px 14px;
  border-bottom: 1px solid var(--line);
  font-size: 12.5px;
  color: var(--text-1);
  cursor: pointer;
}
