<template>
  <div class="pane">
    <aside class="tree">
      <div class="tree__head"><b>Admin</b></div>
      <button
        v-for="s in sections"
        :key="s.id"
        type="button"
        :class="rowClass(s.id)"
        @click="pick(s.id)"
      >
        <Icon :name="s.icon" size="md" />
        <span>{{ s.label }}</span>
      </button>
      <div class="tree__spacer"></div>
      <button type="button" class="tree__dev" @click="openDev">
        <Icon name="develop.terminal" size="md" />
        <span>Developer mode</span>
      </button>
    </aside>
    <section class="body">
      <header class="body__head">
        <h3>{{ activeSection ? activeSection.label : "" }}</h3>
        <p class="body__gate">Prototype console — mutating admin actions are disabled by the safety gate.</p>
      </header>

      <p v-if="activeSection" class="body__note">{{ activeSection.note }}</p>

      <div v-if="section === 'devices'" class="table">
        <div class="table__head">
          <span></span>
          <span>Device</span>
          <span>Last active</span>
          <span>Quota</span>
          <span>Today</span>
        </div>
        <label v-for="d in devices" :key="d.id" class="table__row">
          <input type="checkbox" :checked="selected.includes(d.id)" @change="toggleDevice(d.id)" />
          <span :class="d.flagged ? 'table__flag' : ''">{{ d.name }}</span>
          <span>{{ d.lastActive }}</span>
          <span>{{ d.points }}</span>
          <span>{{ d.today }}</span>
        </label>
        <div class="table__foot">
          <p v-if="selected.length" class="table__confirm">Kick list: {{ selectedNames }} — confirmation dialog would appear here.</p>
          <p v-else class="table__confirm">Select devices to prepare a bulk kick.</p>
          <button type="button" disabled title="D5 safety gate: admin mutations stay behind the policy plane (not built)">Bulk kick</button>
        </div>
      </div>

      <div v-else-if="section === 'billing'" class="cards">
        <div v-for="a in accounts" :key="a.id" class="cards__item">
          <b>{{ a.name }}</b>
          <i>{{ a.plan }}</i>
          <span>{{ a.quota }}</span>
          <em>pending the ledger endpoint</em>
        </div>
      </div>

      <div v-else-if="section === 'approvals'" class="rows">
        <div v-for="a in approvalAgents" :key="a.id" class="rows__item">
          <span :class="'avatar avatar--md avatar--' + a.tone">{{ a.initials }}</span>
          <span class="rows__who">
            <b>{{ a.name }}</b>
            <i>{{ a.pendingApprovals }} capability request(s) awaiting review</i>
          </span>
          <button type="button" disabled title="Approval writes need the policy plane (not built)">Review</button>
        </div>
        <p v-if="approvalAgents.length === 0" class="rows__empty">No pending approvals in the local view.</p>
      </div>

      <div v-else-if="section === 'org'" class="rows">
        <div v-for="d in depts" :key="d" class="rows__item">
          <Icon name="nav.contacts" size="md" />
          <span class="rows__who">
            <b>{{ d }}</b>
            <i>{{ countDept(d) }} member(s) in the local view</i>
          </span>
        </div>
      </div>

      <div v-else class="placeholder">
        <Icon :name="activeSection ? activeSection.icon : 'action.sidebar'" size="lg" />
        <p>{{ activeSection ? activeSection.note : "" }}</p>
      </div>
    </section>
  </div>
</template>

<style>
