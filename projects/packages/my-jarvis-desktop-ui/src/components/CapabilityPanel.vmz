<template>
  <aside class="cap-panel">
    <section class="cap-panel__block">
      <h2 class="cap-panel__title">Session</h2>
      <p class="cap-panel__appid" :title="appId">{{ appId }}</p>
    </section>
    <section class="cap-panel__block">
      <h2 class="cap-panel__title">Capabilities</h2>
      <button
        v-for="entry in entries"
        :key="entry.method"
        class="cap-panel__item"
        :class="{ 'cap-panel__item--active': entry.method === selected }"
        type="button"
        @click="select(entry.method)"
      >
        <code>{{ entry.method }}</code>
        <span>{{ entry.summary }}</span>
      </button>
    </section>
  </aside>
</template>

<style>
.cap-panel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  height: 100%;
  overflow-y: auto;
  padding: 1rem;
  background: #101418;
  color: #d5dbe1;
  border-right: 1px solid #232a31;
}
.cap-panel__title {
  margin: 0 0 0.5rem;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #6b7681;
}
.cap-panel__appid {
  margin: 0;
  font-family: ui-monospace, monospace;
  font-size: 0.75rem;
  color: #8fa3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cap-panel__item {
  display: grid;
  gap: 0.25rem;
  width: 100%;
  margin-bottom: 0.5rem;
  padding: 0.6rem 0.7rem;
  text-align: left;
  border: 1px solid #232a31;
  border-radius: 6px;
  background: #151b21;
  color: inherit;
  cursor: pointer;
}
.cap-panel__item:hover {
  border-color: #3a4652;
}
.cap-panel__item--active {
  border-color: #2f8f5b;
  background: #16211b;
}
.cap-panel__item code {
  font-size: 0.8rem;
  color: #7fd1a4;
}
.cap-panel__item span {
  font-size: 0.75rem;
  color: #7b8794;
}
</style>

<script client>
import type { CatalogEntry } from "../lib/catalog.js";

export default class CapabilityPanel {
  public entries: CatalogEntry[] = [];
  public selected = "";
  public appId = "";
  public onSelect: ((method: string) => void) | null = null;

  select(method: string) {
    this.onSelect?.(method);
  }
}
</script>
