<template>
  <div class="shell">
    <NavRail
      :modules="modules"
      :accounts="accounts"
      :active="activeId"
      :account="currentAccount"
      :account-id="currentAccount.id"
      :show-admin="isAdmin"
      :on-select="selectModule"
      :on-pick-account="pickAccount"
    />
    <template v-if="isAssistant">
      <ConversationList
        :conversations="conversations"
        :active-id="activeConversation"
        :on-select="pickConversation"
      />
      <ChatView
        :messages="messages"
        :on-toggle-detail="toggleDetail"
      />
      <DetailPanel
        v-if="detailOpen"
        :on-close="closeDetail"
      />
    </template>
    <EmptyState
      v-else
      :title="emptyTitle"
      :icon="emptyIcon"
      :note="emptyNote"
      :capability="emptyCapability"
    />
  </div>
</template>

<style>
html,
body,
#app {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow: hidden;
}
.shell {
  --font: "Segoe UI", "PingFang SC", system-ui, -apple-system, sans-serif;
  --font-mono: ui-monospace, "JetBrains Mono", "SF Mono", Consolas, monospace;
  --panel: #ffffff;
  --chat: #f6f7f9;
  --soft: #f2f4f7;
  --field: #eef1f5;
  --hover: rgba(15, 23, 42, 0.05);
  --line: #e8eaef;
  --text-1: #101828;
  --text-2: #475467;
  --text-3: #98a2b3;
  --accent: #0a84ff;
  --accent-hover: #0071e3;
  --accent-soft: #e8f2ff;
  --accent-ink: #0a6ad6;
  --danger: #ff3b30;

  height: 100%;
  display: flex;
  overflow: hidden;
  color: var(--text-1);
  font-family: var(--font);
  font-size: 13px;
  background: #eef1f5;
}
/* Component wrappers are layout-transparent: each component root is the flex item. */
.shell > [data-vmz] {
  display: contents;
}
/* Narrow windows drop the context panel first, matching the layout contract. */
.shell .detail {
  min-width: 236px;
}
.shell .chat {
  min-width: 280px;
}
@media (max-width: 1000px) {
  .shell .detail {
    display: none;
  }
}
.avatar {
  flex: none;
  width: 30px;
  height: 30px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0;
  user-select: none;
}
.avatar--md {
  width: 36px;
  height: 36px;
  font-size: 13px;
}
.avatar--lg {
  width: 38px;
  height: 38px;
  font-size: 13.5px;
}
.avatar--blue {
  background: #e3efff;
  color: #0a6ad6;
}
.avatar--violet {
  background: #efe7ff;
  color: #6941c6;
}
.avatar--green {
  background: #dcf7e7;
  color: #067647;
}
.avatar--amber {
  background: #fdf0d5;
  color: #b54708;
}
.avatar--slate {
  background: #eceff3;
  color: #475467;
}
.avatar--plus {
  background: var(--soft);
  color: var(--text-2);
}
</style>

<script client>
import { defaultAccounts, defaultConversations, defaultMessages, defaultModules, firstAccount, moduleNote } from "../lib/shell.js";

export default class IndexPage {
  modules = defaultModules();
  accounts = defaultAccounts();
  conversations = defaultConversations();
  messages = defaultMessages();
  activeId = "assistant";
  activeConversation = "c1";
  currentAccount = firstAccount();
  isAssistant = true;
  detailOpen = true;
  isAdmin = firstAccount().role === "admin";
  emptyTitle = "Assistant";
  emptyIcon = "spark";
  emptyNote = "";
  emptyCapability = "mj.llm.complete";

  selectModule(id: string) {
    this.activeId = id;
    this.isAssistant = id === "assistant";
    if (this.isAssistant) return;
    const found = this.modules.find((m: { id: string }) => m.id === id);
    if (found) {
      this.emptyTitle = found.label;
      this.emptyIcon = found.icon;
      this.emptyCapability = found.capability;
      this.emptyNote = moduleNote(id);
      return;
    }
    this.emptyTitle = id === "admin" ? "Admin" : "Settings";
    this.emptyIcon = id === "admin" ? "panel" : "settings";
    this.emptyCapability = "mj.*";
    this.emptyNote = "Not connected yet.";
  }

  pickConversation(id: string) {
    this.activeConversation = id;
  }

  toggleDetail() {
    this.detailOpen = !this.detailOpen;
  }

  closeDetail() {
    this.detailOpen = false;
  }

  pickAccount(id: string) {
    const acc = this.accounts.find((a: { id: string }) => a.id === id);
    if (!acc) return;
    this.currentAccount = acc;
    this.isAdmin = acc.role === "admin";
  }
}
</script>
