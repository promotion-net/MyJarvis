<template>
  <div class="shell">
    <NavRail
      :modules="modules"
      :accounts="accounts"
      :active="activeId"
      :account="currentAccount"
      :account-id="currentAccount.id"
      :show-admin="isAdmin"
      :on-select="selectModule"
      :on-pick-account="pickAccount"
    />
    <AssistantPane
      v-if="isMessages"
      :conversations="conversations"
      :messages="messages"
      :active-conversation="activeConversation"
      :detail-open="detailOpen"
      :on-select="pickConversation"
      :on-toggle-detail="toggleDetail"
      :on-close-detail="closeDetail"
    />
    <AgentSettings v-if="isAgents" :on-open-messages="showMessages" />
    <DevConsole v-if="isDev" />
    <EmptyState
      v-if="isEmpty"
      :title="emptyTitle"
      :icon="emptyIcon"
      :note="emptyNote"
      :capability="emptyCapability"
    />
  </div>
</template>

<style>
html,
body,
#app {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow: hidden;
}
.shell {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  overflow: hidden;
  color: var(--text-1);
  font-family: var(--font);
  font-size: 13px;
  background: #eef1f5;
}
/* Narrow windows drop the context panel first, matching the layout contract. */
.shell .detail {
  min-width: 236px;
}
.shell .chat {
  min-width: 280px;
}
@media (max-width: 1000px) {
  .shell .detail {
    display: none;
  }
}
.avatar {
  flex: none;
  width: 30px;
  height: 30px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0;
  user-select: none;
}
.avatar--md {
  width: 36px;
  height: 36px;
  font-size: 13px;
}
.avatar--lg {
  width: 38px;
  height: 38px;
  font-size: 13.5px;
}
.avatar--blue {
  background: #e3efff;
  color: #0a6ad6;
}
.avatar--violet {
  background: #efe7ff;
  color: #6941c6;
}
.avatar--green {
  background: #dcf7e7;
  color: #067647;
}
.avatar--amber {
  background: #fdf0d5;
  color: #b54708;
}
.avatar--slate {
  background: #eceff3;
  color: #475467;
}
.avatar--plus {
  background: var(--soft);
  color: var(--text-2);
}
</style>

<script client>
import { defaultAccounts, defaultConversations, defaultMessages, defaultModules, firstAccount, moduleNote } from "../lib/shell.js";

export default class IndexPage {
  modules = defaultModules();
  accounts = defaultAccounts();
  conversations = defaultConversations();
  messages = defaultMessages();
  activeId = "messages";
  activeConversation = "c1";
  currentAccount = firstAccount();
  isMessages = true;
  isAgents = false;
  isDev = false;
  isEmpty = false;
  detailOpen = true;
  isAdmin = firstAccount().role === "admin";
  emptyTitle = "Messages";
  emptyIcon = "nav.chat";
  emptyNote = "";
  emptyCapability = "mj.llm.complete";

  selectModule(id: string) {
    this.activeId = id;
    if (id === "messages") {
      this.isMessages = true;
      this.isAgents = false;
      this.isDev = false;
      this.isEmpty = false;
      return;
    }
    if (id === "agents") {
      this.isMessages = false;
      this.isAgents = true;
      this.isDev = false;
      this.isEmpty = false;
      return;
    }
    if (id === "dev") {
      this.isMessages = false;
      this.isAgents = false;
      this.isDev = true;
      this.isEmpty = false;
      return;
    }
    this.isMessages = false;
    this.isAgents = false;
    this.isDev = false;
    this.isEmpty = true;
    const found = this.modules.find((m: { id: string }) => m.id === id);
    if (found) {
      this.emptyTitle = found.label;
      this.emptyIcon = found.icon;
      this.emptyCapability = found.capability;
      this.emptyNote = moduleNote(id);
      return;
    }
    this.emptyTitle = id === "admin" ? "Admin" : "Settings";
    this.emptyIcon = id === "admin" ? "action.sidebar" : "action.settings";
    this.emptyCapability = "mj.*";
    this.emptyNote = "Not connected yet.";
  }

  pickConversation(id: string) {
    this.activeConversation = id;
  }

  showMessages() {
    this.selectModule("messages");
  }

  toggleDetail() {
    this.detailOpen = !this.detailOpen;
  }

  closeDetail() {
    this.detailOpen = false;
  }

  pickAccount(id: string) {
    const acc = this.accounts.find((a: { id: string }) => a.id === id);
    if (!acc) return;
    this.currentAccount = acc;
    this.isAdmin = acc.role === "admin";
  }
}
</script>
