<template>
  <div class="shell">
    <NavRail
      :modules="modules"
      :accounts="accounts"
      :active="activeId"
      :account="currentAccount"
      :account-id="currentAccount.id"
      :show-admin="isAdmin"
      :on-select="selectModule"
      :on-pick-account="pickAccount"
    />
    <AssistantPane
      v-if="isMessages"
      :conversations="conversations"
      :messages="messages"
      :active-conversation="activeConversation"
      :detail-open="detailOpen"
      :on-select="pickConversation"
      :on-toggle-detail="toggleDetail"
      :on-close-detail="closeDetail"
    />
    <MailPane v-if="isMail" />
    <DocsPane v-if="isDocs" />
    <SpacePane v-if="isSpace" />
    <AgentSettings v-if="isAgents" :on-open-messages="showMessages" />
    <CalendarPane v-if="isCalendar" :on-open-meeting="showMeetings" />
    <MeetingsPane v-if="isMeetings" />
    <ContactsPane v-if="isContacts" />
    <DevConsole v-if="isDev" />
    <AdminPane v-if="isAdminView" :on-open-dev="showDev" />
    <SettingsPane v-if="isSettings" :scenario="scenario" :on-scenario="applyScenario" />
    <EmptyState
      v-if="isEmpty"
      :title="emptyTitle"
      :icon="emptyIcon"
      :note="emptyNote"
      :capability="emptyCapability"
    />
  </div>
</template>

<style>
html,
body,
#app {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow: hidden;
}
.shell {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  overflow: hidden;
  color: var(--text-1);
  font-family: var(--font);
  font-size: 13px;
  background: var(--shell-bg, #eef1f5);
}
/* Narrow windows drop the context panel first, matching the layout contract. */
.shell .detail {
  min-width: 236px;
}
.shell .chat {
  min-width: 280px;
}
@media (max-width: 1000px) {
  .shell .detail {
    display: none;
  }
}
.avatar {
  flex: none;
  width: 30px;
  height: 30px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0;
  user-select: none;
}
.avatar--md {
  width: 36px;
  height: 36px;
  font-size: 13px;
}
.avatar--lg {
  width: 38px;
  height: 38px;
  font-size: 13.5px;
}
.avatar--blue {
  background: #e3efff;
  color: #0a6ad6;
}
.avatar--violet {
  background: #efe7ff;
  color: #6941c6;
}
.avatar--green {
  background: #dcf7e7;
  color: #067647;
}
.avatar--amber {
  background: #fdf0d5;
  color: #b54708;
}
.avatar--slate {
  background: #eceff3;
  color: #475467;
}
.avatar--plus {
  background: var(--soft);
  color: var(--text-2);
}
</style>

<script client>
import {
  applyNav,
  defaultAccounts,
  defaultConversations,
  defaultMessages,
  firstAccount,
  loadShellNav,
  loadShellScenario,
  moduleNote,
  saveShellScenario,
} from "../lib/shell.js";

const VIEWS = ["messages", "mail", "docs", "space", "agents", "calendar", "meetings", "contacts", "dev", "admin", "settings"];

export default class IndexPage {
  scenario = loadShellScenario();
  modules = applyNav(loadShellScenario(), loadShellNav());
  accounts = defaultAccounts();
  conversations = defaultConversations();
  messages = defaultMessages();
  activeId = "messages";
  activeConversation = "c1";
  currentAccount = firstAccount();
  view = "messages";
  detailOpen = true;
  isAdmin = firstAccount().role === "admin";
  emptyTitle = "Messages";
  emptyIcon = "nav.chat";
  emptyNote = "";
  emptyCapability = "mj.llm.complete";
  detachNav: (() => void) | null = null;

  get isMessages() {
    return this.view === "messages";
  }
  get isMail() {
    return this.view === "mail";
  }
  get isDocs() {
    return this.view === "docs";
  }
  get isSpace() {
    return this.view === "space";
  }
  get isAgents() {
    return this.view === "agents";
  }
  get isCalendar() {
    return this.view === "calendar";
  }
  get isMeetings() {
    return this.view === "meetings";
  }
  get isContacts() {
    return this.view === "contacts";
  }
  get isDev() {
    return this.view === "dev";
  }
  get isAdminView() {
    return this.view === "admin";
  }
  get isSettings() {
    return this.view === "settings";
  }
  get isEmpty() {
    return !VIEWS.includes(this.view);
  }

  onMount() {
    if (typeof window === "undefined") return;
    // Bound closure: class methods are not auto-bound, and listeners need cleanup.
    const onNav = () => {
      this.modules = applyNav(this.scenario, loadShellNav());
    };
    window.addEventListener("mj:navigation", onNav);
    this.detachNav = () => window.removeEventListener("mj:navigation", onNav);
  }

  onDestroy() {
    if (this.detachNav) this.detachNav();
    this.detachNav = null;
  }

  selectModule(id: string) {
    this.activeId = id;
    this.view = id;
    if (!VIEWS.includes(id)) {
      const found = this.modules.find((m: { id: string }) => m.id === id);
      if (found) {
        this.emptyTitle = found.label;
        this.emptyIcon = found.icon;
        this.emptyCapability = found.capability;
        this.emptyNote = moduleNote(id);
        return;
      }
      this.emptyTitle = id;
      this.emptyIcon = "action.sidebar";
      this.emptyCapability = "mj.*";
      this.emptyNote = "Not connected yet.";
    }
  }

  applyScenario(id: string) {
    saveShellScenario(id);
    this.scenario = id;
    this.modules = applyNav(id, loadShellNav());
  }

  pickConversation(id: string) {
    this.activeConversation = id;
  }

  showMessages() {
    this.selectModule("messages");
  }

  showMeetings() {
    this.selectModule("meetings");
  }

  showDev() {
    this.selectModule("dev");
  }

  toggleDetail() {
    this.detailOpen = !this.detailOpen;
  }

  closeDetail() {
    this.detailOpen = false;
  }

  pickAccount(id: string) {
    const acc = this.accounts.find((a: { id: string }) => a.id === id);
    if (!acc) return;
    this.currentAccount = acc;
    this.isAdmin = acc.role === "admin";
    if (this.view === "admin" && !this.isAdmin) this.selectModule("messages");
  }
}
</script>
