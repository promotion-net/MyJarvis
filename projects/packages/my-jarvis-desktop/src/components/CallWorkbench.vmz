<template>
  <main class="workbench">
    <header class="workbench__head">
      <h2 class="workbench__title">Call</h2>
      <code class="workbench__method">{{ method }}</code>
    </header>
    <label class="workbench__field">
      <span class="workbench__label">Params (JSON)</span>
      <textarea
        class="workbench__params"
        :value="paramsJson"
        rows="14"
        spellcheck="false"
        @input="onParamsInput"
      ></textarea>
    </label>
    <p v-if="errorText" class="workbench__error">{{ errorText }}</p>
    <div class="workbench__actions">
      <button class="workbench__run" type="button" :disabled="busy" @click="run">
        {{ busy ? "Running…" : "Run" }}
      </button>
    </div>
  </main>
</template>

<style>
.workbench {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  height: 100%;
  overflow-y: auto;
  padding: 1rem 1.25rem;
  background: #171d23;
  color: #d5dbe1;
}
.workbench__head {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
}
.workbench__title {
  margin: 0;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #6b7681;
}
.workbench__method {
  font-size: 0.9rem;
  color: #7fd1a4;
}
.workbench__field {
  display: grid;
  gap: 0.35rem;
}
.workbench__label {
  font-size: 0.75rem;
  color: #7b8794;
}
.workbench__params {
  width: 100%;
  resize: vertical;
  border: 1px solid #232a31;
  border-radius: 6px;
  background: #101418;
  color: #d5dbe1;
  font-family: ui-monospace, monospace;
  font-size: 0.8rem;
  padding: 0.7rem;
}
.workbench__params:focus {
  outline: none;
  border-color: #3a4652;
}
.workbench__error {
  margin: 0;
  font-size: 0.8rem;
  color: #e57373;
}
.workbench__actions {
  display: flex;
}
.workbench__run {
  padding: 0.55rem 1.4rem;
  border: none;
  border-radius: 6px;
  background: #2f8f5b;
  color: #06130c;
  font-weight: 600;
  cursor: pointer;
}
.workbench__run:disabled {
  background: #2c3a33;
  color: #6b7681;
  cursor: default;
}
</style>

<script client>
export default class CallWorkbench {
  public method = "";
  public paramsJson = "";
  public busy = false;
  public errorText = "";
  public onParamsChange: ((value: string) => void) | null = null;
  public onRun: (() => void) | null = null;

  onParamsInput(event: Event) {
    const target = event.target as HTMLTextAreaElement | null;
    if (target && this.onParamsChange) {
      this.onParamsChange(target.value);
    }
  }

  run() {
    this.onRun?.();
  }
}
</script>
