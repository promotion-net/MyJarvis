<template>
  <aside class="inspector">
    <section class="inspector__block">
      <h2 class="inspector__title">Result</h2>
      <pre v-if="resultText" class="inspector__result">{{ resultText }}</pre>
      <p v-else class="inspector__empty">No result yet.</p>
    </section>
    <section class="inspector__block">
      <h2 class="inspector__title">Call log</h2>
      <ul v-if="log.length" class="inspector__log">
        <li v-for="(row, index) in log" :key="index" :class="{ 'inspector__row--fail': !row.ok }">
          <time>{{ row.time }}</time>
          <code>{{ row.method }}</code>
          <span>{{ row.ok ? "ok" : row.message }}</span>
        </li>
      </ul>
      <p v-else class="inspector__empty">No calls yet.</p>
    </section>
  </aside>
</template>

