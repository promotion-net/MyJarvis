{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MyJarvis",
    "version": "0.1.0",
    "identifier": "app.myjarvis.desktop",
    "build": {
        "beforeDevCommand": "pnpm --filter @my-jarvis/desktop dev",
        "devUrl": "http://localhost:5178",
        "beforeBuildCommand": "pnpm --filter @my-jarvis/desktop build:desktop",
        "frontendDist": "../dist/app"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MyJarvis",
                "width": 1240,
                "height": 780,
                "minWidth": 1024,
                "minHeight": 680,
                "center": true,
                "resizable": true
            }
        ],
        "withGlobalTauri": true,
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false
    }
}
